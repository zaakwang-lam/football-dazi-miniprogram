.page {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 40rpx 32rpx;
}
.doc-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}
.doc-content .doc-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #1A1A1A;
}
.doc-content .doc-subtitle {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  color: #1A1A1A;
}
.doc-content .doc-meta {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
}
.doc-content .doc-section {
  margin-bottom: 24rpx;
}
.doc-content view {
  margin-bottom: 8rpx;
}