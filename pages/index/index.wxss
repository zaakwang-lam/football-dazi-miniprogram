/* pages/index/index.wxss */
.page {
  padding-bottom: 24rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C42 100%);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #999999;
}

.search-icon {
  margin-right: 12rpx;
}

/* 首页轮播 */
.hero-swiper {
  margin: 24rpx;
  height: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.hero-banner {
  position: relative;
  margin: 24rpx;
  height: 280rpx;
  border-radius: 32rpx;
  background: #2BB673;
  display: flex;
  align-items: center;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(43, 182, 115, 0.25);
  overflow: hidden;
}

.hero-swiper .hero-banner {
  margin: 0;
  height: 100%;
  border-radius: 32rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  z-index: 1;
}

.entry-grid {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-icon-img {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.entry-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.section {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.lfg-list {
  padding: 0 32rpx;
}

.lfg-item {
  display: flex;
  padding: 24rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.lfg-left {
  margin-right: 20rpx;
}

.lfg-type {
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.lfg-type.type-sub {
  background: #FFE8D6;
  color: #FF6B00;
}

.lfg-type.type-war {
  background: #E6F2FF;
  color: #007AFF;
}

.lfg-right {
  flex: 1;
  min-width: 0;
}

.lfg-row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.lfg-team {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.lfg-time {
  font-size: 22rpx;
  color: #999999;
}

.lfg-row2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lfg-loc {
  font-size: 24rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  margin-right: 8rpx;
}

.lfg-need {
  font-size: 24rpx;
  color: #FF4757;
  font-weight: 600;
}

.lfg-call {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 16rpx;
  background: #FFE8D6;
  color: #FF6B00;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
