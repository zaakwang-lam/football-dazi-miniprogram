<!-- pages/index/index.wxml -->
<view class="page">
  <view class="top-bar">
    <view class="search-box" bindtap="onSearchTap">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索场地 / 球队</text>
    </view>
  </view>

  <swiper
    class="hero-swiper"
    indicator-dots="{{banners.length > 1}}"
    autoplay="{{banners.length > 1}}"
    interval="4000"
    circular="{{banners.length > 1}}"
    wx:if="{{banners.length > 0}}"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="hero-banner" bindtap="onBannerTap" data-url="{{item.linkUrl}}">
        <image class="hero-bg" src="{{item.imageUrl}}" mode="aspectFill"></image>
      </view>
    </swiper-item>
  </swiper>
  <view class="hero-banner" bindtap="onBannerTap" wx:else>
    <image class="hero-bg" src="/images/hero/bg.png" mode="aspectFill"></image>
  </view>

  <view class="entry-grid">
    <view class="entry-item" bindtap="onEntryTap" data-type="book">
      <image class="entry-icon-img" src="/images/tab/book.png" mode="aspectFit"></image>
      <text class="entry-label">订场</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-type="lfg">
      <image class="entry-icon-img" src="/images/tab/lfg.png" mode="aspectFit"></image>
      <text class="entry-label">凑人</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-type="war">
      <image class="entry-icon-img" src="/images/tab/war.png" mode="aspectFit"></image>
      <text class="entry-label">约战</text>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">⚡ 进行中</text>
    </view>
    <view class="lfg-list" wx:if="{{lfgList.length > 0}}">
      <view class="lfg-item" wx:for="{{lfgList}}" wx:key="id" bindtap="onLfgTap" data-id="{{item.id}}">
        <view class="lfg-left">
          <view class="lfg-type type-{{item.typeKey}}">{{item.typeLabel}}</view>
        </view>
        <view class="lfg-right">
          <view class="lfg-row1">
            <text class="lfg-team">{{item.teamName}}</text>
            <text class="lfg-time">{{item.time}}</text>
          </view>
          <view class="lfg-row2">
            <text class="lfg-loc">📍 {{item.location}}</text>
            <text class="lfg-need" wx:if="{{item.showNeed}}">缺 {{item.need}} 人</text>
            <text class="lfg-need war-tag" wx:else>约战</text>
          </view>
        </view>
        <view class="lfg-call" catchtap="onContactCaptain" data-phone="{{item.contact}}">联系队长</view>
      </view>
    </view>
    <view class="empty-lfg" wx:else>
      <text>暂无进行中的凑人/约战</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
