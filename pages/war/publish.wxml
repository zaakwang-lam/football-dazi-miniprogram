<!-- pages/war/publish.wxml - 发起约战 -->
<view class="page">
  <view class="form-title">发起约战</view>
  <view class="form-subtitle">球队对球队，向对手发起挑战</view>

  <view class="form-group" wx:if="{{ready}}">
    <view class="form-label required">队伍名称</view>
    <picker wx:if="{{myTeams.length > 1}}" mode="selector" range="{{myTeams}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamPick">
      <view class="form-input picker-val">{{form.teamName}} ›</view>
    </picker>
    <input wx:else class="form-input" disabled value="{{form.teamName}}" />
    <view class="form-hint">仅已加入球队可发起，队名自动带入</view>
  </view>

  <view class="form-group">
    <view class="form-label required">比赛地点</view>
    <view class="loc-row">
      <input class="form-input loc-flex" placeholder="点击右侧地图选点" value="{{form.location}}" disabled />
      <view class="btn-map" bindtap="onChooseLocation">地图选点</view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label required">比赛时间</view>
    <view class="time-row">
      <picker mode="date" value="{{form.dateValue}}" start="{{dateMin}}" end="{{dateMax}}" bindchange="onDateChange">
        <view class="time-cell">
          <text wx:if="{{form.dateText}}" style="color:#1A1A1A;font-weight:500;">{{form.dateText}}</text>
          <text wx:else style="color:#999999;">选日期</text>
        </view>
      </picker>
      <picker mode="time" value="{{form.timeValue}}" bindchange="onTimeChange">
        <view class="time-cell">
          <text wx:if="{{form.timeText}}" style="color:#1A1A1A;font-weight:500;">{{form.timeText}}</text>
          <text wx:else style="color:#999999;">选时间</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label required">人制（单选）</view>
    <view class="checkbox-group">
      <view class="checkbox-item {{form.matchType === item ? 'active' : ''}}" wx:for="{{matchTypeOptions}}" wx:key="*this" bindtap="onMatchTypeSelect" data-value="{{item}}">
        <view class="radio {{form.matchType === item ? 'checked' : ''}}">{{form.matchType === item ? '●' : ''}}</view>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label required">队伍水平</view>
    <view class="level-row">
      <view class="level-item {{form.level === '养生' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="养生">养生</view>
      <view class="level-item {{form.level === '竞技' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="竞技">竞技</view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">人均费用（元，可选）</view>
    <input class="form-input" placeholder="如：30" value="{{form.fee}}" bindinput="onInput" data-key="fee" type="digit" />
  </view>

  <view class="form-group">
    <view class="form-label required">联系手机</view>
    <input class="form-input" type="number" maxlength="11" placeholder="请输入11位手机号码" value="{{form.contact}}" bindinput="onInput" data-key="contact" />
  </view>

  <view class="bottom-action safe-bottom">
    <view class="btn-primary full" bindtap="onSubmit">发布约战</view>
  </view>
</view>
