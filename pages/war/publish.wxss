/* pages/war/publish.wxss */
.page { padding: 24rpx; padding-bottom: 200rpx; }
.form-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 8rpx; }
.form-subtitle { font-size: 24rpx; color: #666; margin-bottom: 24rpx; }
.form-group {
  background: #fff; border-radius: 24rpx; padding: 24rpx 32rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.form-label { font-size: 26rpx; color: #999; margin-bottom: 12rpx; }
.form-label.required::before { content: '* '; color: #FF4757; }
.form-input { font-size: 30rpx; color: #1A1A1A; width: 100%; padding: 8rpx 0; }
.form-textarea { font-size: 28rpx; color: #1A1A1A; width: 100%; min-height: 140rpx; }
.loc-row { display: flex; align-items: center; gap: 16rpx; }
.loc-flex { flex: 1; }
.btn-map {
  flex-shrink: 0; padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #fff; border-radius: 12rpx; font-size: 26rpx; font-weight: 600;
}
.time-row { display: flex; gap: 16rpx; }
.time-cell {
  flex: 1; background: #F5F5F5; border-radius: 8rpx; padding: 20rpx;
  font-size: 28rpx; text-align: center;
}
.checkbox-group { display: flex; flex-wrap: wrap; gap: 12rpx; }
.checkbox-item {
  display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx;
  background: #F5F7FA; border-radius: 999rpx; font-size: 26rpx; color: #666;
}
.checkbox-item.active { background: #FFE8D6; color: #FF6B00; font-weight: 600; }
.radio {
  width: 28rpx; height: 28rpx; border: 2rpx solid #ccc; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 16rpx;
}
.radio.checked { border-color: #FF6B00; color: #FF6B00; }
.level-row { display: flex; gap: 16rpx; }
.level-item {
  flex: 1; text-align: center; padding: 16rpx 0; background: #F5F7FA;
  border-radius: 12rpx; font-size: 28rpx; color: #666;
}
.level-item.active {
  background: linear-gradient(135deg, #FF6B00, #FF8C42); color: #fff; font-weight: 600;
}
.bottom-action {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx;
  background: #fff; border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.btn-primary.full {
  text-align: center; background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #fff; border-radius: 999rpx; padding: 24rpx 0; font-size: 30rpx; font-weight: 600;
}
