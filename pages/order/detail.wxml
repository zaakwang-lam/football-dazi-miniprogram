<!-- pages/order/detail.wxml -->
<view class="page" wx:if="{{order}}">
  <view class="status-card status-{{order.statusKey}}">
    <view class="status-icon">{{order.icon}}</view>
    <view class="status-text">{{order.status}}</view>
    <view class="status-desc">{{order.statusDesc}}</view>
  </view>

  <view class="court-block">
    <view class="block-name">{{order.courtName}}</view>
    <view class="block-meta">{{order.date}}</view>
    <view class="block-divider"></view>
    <view class="block-row">
      <text class="row-label">订单号</text>
      <text class="row-value">{{order.orderNo || order.id}}</text>
    </view>
    <view class="block-row">
      <text class="row-label">下单时间</text>
      <text class="row-value">{{order.createdAt}}</text>
    </view>
    <view class="block-row">
      <text class="row-label">联系人</text>
      <text class="row-value">{{order.name}}</text>
    </view>
    <view class="block-row">
      <text class="row-label">联系电话</text>
      <text class="row-value">{{order.phone}}</text>
    </view>
  </view>

  <view class="price-block">
    <view class="price-row">
      <text>场地费（到场结算）</text>
      <text class="price-val">¥{{order.price}}</text>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{order.status === '已预订'}}">
    <view class="btn-secondary" bindtap="onCancelBook">取消预订</view>
    <view class="btn-primary" bindtap="onContactCourt">联系球场方</view>
  </view>
</view>
