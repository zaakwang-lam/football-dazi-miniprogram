/* pages/court/detail.wxss */
.page {
  padding: 0 0 200rpx;
}

.hero {
  padding: 80rpx 32rpx 60rpx;
  color: #FFFFFF;
  border-radius: 0 0 48rpx 48rpx;
}

.hero-type {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-tag {
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.info-block {
  background: #FFFFFF;
  margin: -40rpx 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
  align-items: center;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.info-value.phone {
  color: #FF6B00;
  text-decoration: underline;
}

.info-value.price {
  color: #FF6B00;
  font-weight: 700;
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 16rpx 32rpx;
}

/* 排期表 */
.schedule-block {
  background: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.schedule-scroll {
  white-space: nowrap;
}

.schedule-row {
  display: inline-flex;
}

.time-col {
  display: flex;
  flex-direction: column;
}

.time-cell {
  width: 88rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #666666;
  border-right: 2rpx solid #F5F7FA;
  border-bottom: 2rpx solid #F5F7FA;
}

.time-cell.header {
  font-weight: 700;
  color: #1A1A1A;
  background: #FFE8D6;
}

.day-col {
  display: flex;
  flex-direction: column;
}

.day-cell {
  width: 88rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border-right: 2rpx solid #F5F7FA;
  border-bottom: 2rpx solid #F5F7FA;
}

.day-cell.header {
  font-weight: 700;
  color: #1A1A1A;
  background: #FFE8D6;
}

.day-cell.status-free {
  background: #E8F8EE;
  color: #2ECC71;
  font-weight: 600;
}

.day-cell.status-booked {
  background: #F5F7FA;
  color: #999999;
}

.schedule-legend {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #666666;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.dot.free {
  background: #E8F8EE;
  border: 2rpx solid #2ECC71;
}

.dot.booked {
  background: #F5F7FA;
  border: 2rpx solid #999999;
}

/* 评价 */
.review-block {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.review-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FACFE, #00F2FE);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.review-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.review-rating {
  font-size: 22rpx;
  color: #FFB800;
}

.review-date {
  margin-left: auto;
  font-size: 22rpx;
  color: #999999;
}

.review-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-bar .btn-primary {
  flex: 1;
}