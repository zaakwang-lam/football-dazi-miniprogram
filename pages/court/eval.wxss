/* pages/court/eval.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.hero {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  padding: 60rpx 32rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
}

.form-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.form-textarea {
  font-size: 28rpx;
  color: #1A1A1A;
  width: 100%;
  min-height: 180rpx;
  padding: 8rpx 0;
}

.rating {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 56rpx;
  color: #E0E0E0;
  line-height: 1;
}

.star.active {
  color: #FFB800;
}

/* 图片 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.img-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #999999;
  border: 2rpx dashed #CCCCCC;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-primary.full {
  display: block;
  width: 100%;
}