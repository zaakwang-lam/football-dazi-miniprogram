/* pages/court/list.wxss */
.page {
  padding: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-clear {
  color: #999;
  padding: 0 8rpx;
  font-size: 24rpx;
}

.loc-btn {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  background: #FFE8D6;
  color: #FF6B00;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow-x: auto;
}

.filter-item {
  flex-shrink: 0;
  text-align: center;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #666666;
  border-radius: 999rpx;
}

.filter-item.active {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  font-weight: 600;
}

.court-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.court-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.court-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.court-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.court-type-badge {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.95);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FF6B00;
  font-weight: 700;
}

.court-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.court-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.court-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666666;
}

.meta-item.distance {
  color: #FF6B00;
  font-weight: 600;
}

.court-addr {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.court-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.court-tags .tag {
  padding: 4rpx 12rpx;
  background: #F5F7FA;
  color: #666666;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.court-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.court-price {
  display: flex;
  align-items: baseline;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B00;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
