/* pages/court/list.wxss */
.page {
  padding: 24rpx;
}

.filter-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-radius: 999rpx;
}

.filter-item.active {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  font-weight: 600;
}

.court-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.court-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.court-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 12rpx;
}

.court-type-badge {
  background: rgba(255, 255, 255, 0.95);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FF6B00;
  font-weight: 700;
}

.court-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.court-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.court-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666666;
}

.court-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.court-tags .tag {
  padding: 4rpx 12rpx;
  background: #F5F7FA;
  color: #666666;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.court-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.court-price {
  display: flex;
  align-items: baseline;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B00;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}