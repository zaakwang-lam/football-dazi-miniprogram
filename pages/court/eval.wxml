<!-- pages/court/eval.wxml -->
<view class="page">
  <view class="hero">
    <view class="hero-icon">⭐</view>
    <view class="hero-title">评价场地</view>
  </view>

  <view class="form-group">
    <view class="form-label">评分</view>
    <view class="rating">
      <text class="star {{form.rating >= index + 1 ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" bindtap="onStarTap" data-idx="{{index}}">★</text>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">评价内容</view>
    <textarea class="form-textarea" placeholder="说说你的体验吧..." value="{{form.content}}" bindinput="onInput" data-key="content" maxlength="200" />
  </view>

  <view class="form-group">
    <view class="form-label">添加图片（可选）</view>
    <view class="image-list">
      <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="img-delete" bindtap="onImageDelete" data-idx="{{index}}">×</view>
      </view>
      <view class="image-add" bindtap="onImageAdd" wx:if="{{form.images.length < 9}}">+</view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-primary full" bindtap="onSubmit">提交评价</view>
  </view>
</view>