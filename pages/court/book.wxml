<!-- pages/court/book.wxml -->
<view class="page" wx:if="{{court}}">
  <view class="court-summary">
    <view class="cs-name">{{court.name}}</view>
    <view class="cs-meta">{{court.type}} · 到场结算</view>
  </view>

  <view class="form-group">
    <view class="form-label">选择日期</view>
    <scroll-view scroll-x class="date-scroll">
      <view class="date-item {{form.dateIdx === index ? 'active' : ''}}" wx:for="{{dateList}}" wx:key="dateKey" bindtap="onDateSelect" data-idx="{{index}}">
        <view class="date-day">{{item.week}}</view>
        <view class="date-num">{{item.day}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="form-group">
    <view class="form-label">选择时段</view>
    <view class="empty-slots" wx:if="{{!daySlots.length}}" bindtap="onGoPublishHint">
      <text>该日暂无可订时段</text>
      <text class="empty-hint" wx:if="{{!hasAnySlot}}">球场方尚未发布空闲，点此了解</text>
    </view>
    <view class="time-grid" wx:else>
      <view class="time-item {{form.slotIdx === index ? 'active' : ''}} {{item.status === 'booked' || item.status === 'closed' ? 'disabled' : ''}}" wx:for="{{daySlots}}" wx:key="id" bindtap="onSlotSelect" data-idx="{{index}}">
        <view class="time-hour">{{item.timeSlot || item.time}}</view>
        <view class="time-status">{{item.status === 'booked' ? '已订' : (item.status === 'closed' ? '关闭' : ('¥' + (item.price != null ? item.price : '')))}}</view>
      </view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">联系人</view>
    <input class="form-input" placeholder="姓名" value="{{form.name}}" bindinput="onInput" data-key="name" />
  </view>

  <view class="form-group">
    <view class="form-label">联系电话</view>
    <input class="form-input" type="number" placeholder="手机号" value="{{form.phone}}" bindinput="onInput" data-key="phone" />
  </view>

  <view class="form-group">
    <view class="form-label">备注</view>
    <textarea class="form-textarea" placeholder="选填" value="{{form.remark}}" bindinput="onInput" data-key="remark" />
  </view>

  <view class="summary-card">
    <view class="summary-row">
      <text>场地费（到场结算）</text>
      <text class="summary-price">¥{{totalPrice}}</text>
    </view>
    <view class="summary-row">
      <text>时段</text>
      <text>{{form.dateText}} {{form.slotText || '未选择'}}</text>
    </view>
    <view class="summary-row total">
      <text class="text-bold">合计</text>
      <text class="summary-total">¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{form.slotIdx >= 0}}">
    <view class="summary-left">
      <text class="summary-price">¥{{totalPrice}}/场</text>
      <text class="summary-tip">付款请到球场</text>
    </view>
    <view class="btn-primary" bindtap="onSubmit">立即预订</view>
  </view>
</view>
