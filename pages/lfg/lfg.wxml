<!-- pages/lfg/lfg.wxml -->
<view class="page">
  <!-- 顶部简单标题 -->
  <view class="page-header">
    <text class="page-title">👥 凑人</text>
    <text class="page-sub">个人顶个人，找不到人赶紧来</text>
  </view>

  <!-- 筛选条 -->
  <view class="filter-bar">
    <view class="filter-item" bindtap="onFilterTap" data-key="distance">
      <text>📍 距离</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-key="level">
      <text>⭐ 水平</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-key="time">
      <text>🕐 时间</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-key="district">
      <text>🏙 区域</text>
    </view>
  </view>

  <!-- 信息流 -->
  <view class="lfg-list">
    <view class="lfg-card" wx:for="{{list}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <view class="card-top">
        <view class="card-type type-sub">
          <text class="type-icon">🙋</text>
          <text>凑人</text>
        </view>
        <text class="card-time">{{item.publishTime}}</text>
      </view>

      <view class="card-main">
        <view class="main-row">
          <text class="team-name">{{item.teamName}}</text>
          <text class="need-num">缺 {{item.need}} 人</text>
        </view>
        <view class="main-info">
          <text class="info-item">📍 {{item.location}}</text>
          <text class="info-item">🕐 {{item.playTimeText}}</text>
          <text class="info-item" wx:if="{{item.matchTypesText}}">{{item.matchTypesText}}</text>
          <text class="info-item" wx:if="{{item.fee !== null && item.fee !== undefined}}">💰 ¥{{item.fee}}</text>
        </view>
        <view class="main-desc">{{item.desc}}</view>
      </view>

      <view class="card-bottom">
        <text class="contact-info">💬 {{item.contact}}</text>
        <view class="action-btn" catchtap="onActionTap" data-id="{{item.id}}">
          我要加入
        </view>
      </view>
    </view>
  </view>

  <!-- 浮动 + 按钮 -->
  <view class="fab" bindtap="onPublishTap">
    <text>+</text>
  </view>

  <!-- 空状态（已去掉足球图标） -->
  <view class="empty" wx:if="{{list.length === 0 && loaded}}">
    <text>暂无凑人信息</text>
    <view class="empty-tip">点 + 发起一个凑人</view>
  </view>
</view>
