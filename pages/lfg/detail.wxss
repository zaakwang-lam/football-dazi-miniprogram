/* pages/lfg/detail.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-badge {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.type-badge.type-sub {
  background: #FFE8D6;
  color: #FF6B00;
}

.type-badge.type-war {
  background: #E6F2FF;
  color: #007AFF;
}

.type-badge.type-join {
  background: #E8F8EE;
  color: #2ECC71;
}

.type-icon {
  margin-right: 12rpx;
}

.status {
  font-size: 24rpx;
  color: #2ECC71;
  font-weight: 600;
  padding: 6rpx 20rpx;
  background: #E8F8EE;
  border-radius: 999rpx;
}

.info-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.info-value.need {
  color: #FF4757;
  font-weight: 700;
}

.desc-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-bar .btn-primary,
.bottom-bar .btn-secondary {
  flex: 1;
  text-align: center;
}
/* 退出按钮（2026-07-28 新增） */
.btn-quit {
  background: #fff !important;
  color: #FF3B30 !important;
  border: 2rpx solid #FF3B30 !important;
}
