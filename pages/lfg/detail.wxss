/* pages/lfg/detail.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-badge {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.type-badge.type-sub {
  background: #FFE8D6;
  color: #FF6B00;
}

.type-badge.type-war {
  background: #E6F2FF;
  color: #007AFF;
}

.type-badge.type-join {
  background: #E8F8EE;
  color: #2ECC71;
}

.type-icon {
  margin-right: 12rpx;
}

.status {
  font-size: 24rpx;
  color: #2ECC71;
  font-weight: 600;
  padding: 6rpx 20rpx;
  background: #E8F8EE;
  border-radius: 999rpx;
}

.info-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.info-value.need {
  color: #FF4757;
  font-weight: 700;
}

.desc-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-bar .btn-primary,
.bottom-bar .btn-secondary {
  flex: 1;
  text-align: center;
}

.btn-quit {
  background: #fff !important;
  color: #FF3B30 !important;
  border: 2rpx solid #FF3B30 !important;
}

.joiners-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.joiner-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.joiner-row:last-child {
  border-bottom: none;
}

.joiner-card {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.joiner-card:last-of-type {
  border-bottom: none;
}

.joiner-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.joiner-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.joiner-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.joiner-meta,
.joiner-phone {
  font-size: 24rpx;
  color: #666;
}

.joiner-call {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  background: #FFE8D6;
  color: #FF6B00;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.status-pending { background: #FFF3E0; color: #FF6B00; }
.status-success { background: #E8F5E9; color: #2E7D32; }
.status-canceled { background: #F5F5F5; color: #999; }

.joiner-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.btn-call,
.btn-accept,
.btn-reject {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-call { background: #FFE8D6; color: #FF6B00; }
.btn-accept { background: linear-gradient(135deg, #FF6B00, #FF8C42); color: #fff; }
.btn-reject { background: #fff; color: #FF3B30; border: 2rpx solid #FF3B30; }

.btn-wait {
  background: #FFF3E0 !important;
  color: #FF6B00 !important;
  border: none !important;
}

.joiner-empty {
  padding: 24rpx 0 8rpx;
  color: #999;
  font-size: 26rpx;
}

.join-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.join-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.join-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.join-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.join-label {
  font-size: 26rpx;
  color: #666;
  margin: 16rpx 0 10rpx;
}

.join-label .req {
  color: #FF3B30;
}

.join-input,
.join-picker {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.join-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn-ghost {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #F5F7FA;
  color: #666;
  font-size: 28rpx;
}

.join-submit {
  flex: 1.4;
}
