<!-- pages/lfg/detail.wxml -->
<view class="page" wx:if="{{detail}}">
  <view class="header">
    <view class="type-badge type-{{detail.typeKey}}">
      <text class="type-icon">{{detail.icon}}</text>
      <text>{{detail.typeLabel}}</text>
    </view>
    <view class="status">{{detail.status}}</view>
  </view>

  <view class="info-block">
    <view class="info-row">
      <text class="info-label">球队</text>
      <text class="info-value">{{detail.teamName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">时间</text>
      <text class="info-value">{{detail.time}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">地点</text>
      <text class="info-value">{{detail.location}}</text>
    </view>
    <view class="info-row" wx:if="{{detail.matchTypes && detail.matchTypes.length > 0}}">
      <text class="info-label">人制</text>
      <text class="info-value">{{detail.matchTypesText}}</text>
    </view>
    <view class="info-row" wx:if="{{detail.fee !== null && detail.fee !== undefined}}">
      <text class="info-label">人均费用</text>
      <text class="info-value fee">¥{{detail.fee}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">水平</text>
      <text class="info-value">{{detail.level}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">缺人</text>
      <text class="info-value need">{{detail.joinedCount}} / {{detail.need}} 人</text>
    </view>
    <view class="info-row">
      <text class="info-label">联系</text>
      <text class="info-value">{{detail.contact}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">发布时间</text>
      <text class="info-value text-3">{{detail.publishTime}}</text>
    </view>
  </view>

  <view class="desc-block" wx:if="{{detail.desc}}">
    <view class="block-title">详情</view>
    <view class="desc-content">{{detail.desc}}</view>
  </view>

  <view class="joiners-block" wx:if="{{detail.isPublisher}}">
    <view class="block-title">{{detail.typeKey === 'war' ? '应战申请' : '报名申请'}}（{{detail.joinsDisplay.length}}）</view>
    <view class="joiner-card" wx:for="{{detail.joinsDisplay}}" wx:key="id">
      <view class="joiner-head">
        <view class="joiner-main">
          <text class="joiner-name">{{item.displayName}}</text>
          <text class="joiner-meta" wx:if="{{detail.typeKey === 'war' && item.contactName}}">联系人 {{item.contactName}}</text>
          <text class="joiner-phone">{{item.contactPhone || '未留电话'}}</text>
        </view>
        <view class="status-tag status-{{item.statusCls}}">{{item.statusLabel}}</view>
      </view>
      <view class="joiner-actions">
        <view class="btn-call" wx:if="{{item.contactPhone}}" catchtap="onCallJoiner" data-phone="{{item.contactPhone}}">拨打</view>
        <view class="btn-accept" wx:if="{{item.status === 'pending'}}" catchtap="onConfirmJoin" data-id="{{item.id}}">确认</view>
        <view class="btn-reject" wx:if="{{item.status === 'pending'}}" catchtap="onRejectJoin" data-id="{{item.id}}">拒绝</view>
      </view>
    </view>
    <view class="joiner-empty" wx:if="{{detail.joinsDisplay.length === 0}}">暂无人报名，有人申请后可在此确认</view>
  </view>

  <view class="safe-bottom"></view>

  <view class="bottom-bar">
    <view class="btn-secondary" bindtap="onContactTap">联系队长</view>
    <view class="btn-primary" wx:if="{{!detail.joined && !detail.isPublisher}}" bindtap="onJoinTap">{{detail.actionText}}</view>
    <view class="btn-secondary btn-wait" wx:elif="{{detail.myJoinStatus === 'pending'}}" bindtap="onQuitTap">待确认 · 取消</view>
    <view class="btn-secondary btn-quit" wx:elif="{{detail.joined && !detail.isPublisher}}" bindtap="onQuitTap">退出组队</view>
  </view>
</view>

<view class="join-mask" wx:if="{{showJoinForm}}" catchtap="onCloseJoin">
  <view class="join-sheet" catchtap="noop">
    <view class="join-title">{{joinFormTitle}}</view>
    <view class="join-tip">提交后由发起方在小程序确认，请保持电话畅通</view>

    <block wx:if="{{detail.typeKey === 'war'}}">
      <view class="join-label">参赛队伍 <text class="req">*</text></view>
      <picker wx:if="{{myTeams.length}}" range="{{teamNames}}" value="{{joinForm.teamIndex}}" bindchange="onJoinTeamChange">
        <view class="join-picker">{{joinForm.teamName || '请选择队伍'}}</view>
      </picker>
      <input
        wx:else
        class="join-input"
        placeholder="请填写队伍名称"
        value="{{joinForm.teamName}}"
        bindinput="onJoinTeamName"
      />
      <view class="join-label">联系人 <text class="req">*</text></view>
      <input class="join-input" placeholder="请填写联系人姓名" value="{{joinForm.contactName}}" bindinput="onJoinName" />
    </block>
    <block wx:else>
      <view class="join-label">姓名 <text class="req">*</text></view>
      <input class="join-input" placeholder="请填写真实姓名" value="{{joinForm.contactName}}" bindinput="onJoinName" />
    </block>

    <view class="join-label">联系电话 <text class="req">*</text></view>
    <input
      class="join-input"
      type="number"
      maxlength="11"
      placeholder="11位手机号"
      value="{{joinForm.contactPhone}}"
      bindinput="onJoinPhone"
    />

    <view class="join-actions">
      <view class="btn-ghost" bindtap="onCloseJoin">取消</view>
      <view class="btn-primary join-submit" bindtap="onSubmitJoin">确认提交</view>
    </view>
  </view>
</view>
