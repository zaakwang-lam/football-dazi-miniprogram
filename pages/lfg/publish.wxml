<!-- pages/lfg/publish.wxml - 发布凑人 -->
<view class="page">
  <view class="form-title">发起凑人</view>
  <view class="form-subtitle">个人顶个人，找不到人赶紧来</view>
  <view class="form-tip">例如：你 6 人到场，还差 5 个 → 发布</view>

  <view class="form-group">
    <view class="form-label">球队名称</view>
    <input class="form-input" placeholder="请输入球队名称" value="{{form.teamName}}" bindinput="onInput" data-key="teamName" />
  </view>

  <view class="form-group">
    <view class="form-label">地点</view>
    <input class="form-input" placeholder="如：天河体育中心" value="{{form.location}}" bindinput="onInput" data-key="location" />
  </view>

  <view class="form-group">
    <view class="form-label">时间</view>
    <view class="form-input" style="min-height:44rpx;padding:8rpx 0;" bindtap="onPickTime">
      <text wx:if="{{form.timeText}}" style="color:#1A1A1A;font-weight:500;">{{form.timeText}}</text>
      <text wx:else style="color:#999999;">点击选择时间</text>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">缺人数</view>
    <view class="number-picker">
      <view class="picker-btn" bindtap="onNumChange" data-delta="-1">-</view>
      <text class="picker-num">{{form.needCount}}</text>
      <view class="picker-btn" bindtap="onNumChange" data-delta="1">+</view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">水平</view>
    <view class="level-selector">
      <view class="level-item {{form.level === '新手友好' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="新手友好">新手友好</view>
      <view class="level-item {{form.level === '业余' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="业余">业余</view>
      <view class="level-item {{form.level === '业余校队' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="业余校队">业余校队</view>
      <view class="level-item {{form.level === '职业' ? 'active' : ''}}" bindtap="onLevelSelect" data-level="职业">职业</view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">联系方式</view>
    <input class="form-input" placeholder="如：微信同名 / 王队长" value="{{form.contact}}" bindinput="onInput" data-key="contact" />
  </view>

  <view class="form-group">
    <view class="form-label">详细说明</view>
    <textarea class="form-textarea" placeholder="补充说明（位置/人数/费用）" value="{{form.desc}}" bindinput="onInput" data-key="desc" maxlength="200"></textarea>
  </view>

  <view class="bottom-action safe-bottom">
    <view class="btn-primary full" bindtap="onSubmit">立即发布</view>
  </view>
</view>