/* pages/lfg/publish.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.form-subtitle { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.form-tip { font-size: 22rpx; color: #999; margin-bottom: 24rpx; }

.form-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}
.form-label.required::before { content: '* '; color: #FF4757; }

.form-input {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  width: 100%;
  padding: 8rpx 0;
}

.form-textarea {
  font-size: 28rpx;
  color: #1A1A1A;
  width: 100%;
  min-height: 160rpx;
  padding: 8rpx 0;
}

.loc-row { display: flex; align-items: center; gap: 16rpx; }
.loc-flex { flex: 1; }
.btn-map {
  flex-shrink: 0; padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #fff; border-radius: 12rpx; font-size: 26rpx; font-weight: 600;
}

.number-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.picker-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F7FA;
  color: #FF6B00;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B00;
  min-width: 60rpx;
  text-align: center;
}

.level-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-item {
  padding: 12rpx 28rpx;
  background: #F5F7FA;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
}

.level-item.active {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  font-weight: 600;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-primary.full {
  display: block;
  width: 100%;
  text-align: center;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.time-row { display: flex; gap: 16rpx; }
.time-cell {
  flex: 1;
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 40rpx;
  text-align: center;
}
