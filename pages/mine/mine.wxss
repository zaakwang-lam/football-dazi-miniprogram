/* pages/mine/mine.wxss */
.page {
  padding: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  color: #FFFFFF;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-avatar.placeholder {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 24rpx;
  opacity: 0.9;
}

.login-btn {
  display: inline-block;
  margin-top: 12rpx;
  background: #FFFFFF;
  color: #FF6B00;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 【2026-08-05 新增】退出登录按钮 */
.logout-btn {
  display: inline-block;
  margin-top: 12rpx;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.stats-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B00;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #FFE8D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.icon-order { background: #FFE8D6; }
.icon-team { background: #E6F2FF; }
.icon-coupon { background: #FFF7E6; }
.icon-wallet { background: #E8F8EE; }
.icon-msg { background: #F0E8FF; }
.icon-cert { background: #E8F8EE; }
.icon-about { background: #E6F2FF; }
.icon-feedback { background: #FFE8D6; }

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

.badge {
  background: #FF4757;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.user-role {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  background: rgba(255,255,255,0.18);
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.register-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.register-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
}

.register-sub {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.register-options {
  display: flex;
  gap: 24rpx;
}

.register-option {
  flex: 1;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.register-option:active {
  border-color: #FF6B00;
  background: #FFE8D6;
}

.register-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.register-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.register-desc {
  font-size: 22rpx;
  color: #999;
}

.menu-section-title {
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0 8rpx;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.status-tag.status-ok {
  background: #E8F8EE;
  color: #2ECC71;
}

.status-tag.status-pending {
  background: #FFF7E6;
  color: #FF9500;
}

.icon-create, .icon-join, .icon-court, .icon-info, .icon-publish, .icon-list {
  background: #FFE8D6;
}
/* 我的球队 inline 列表（2026-07-28 新增） */
.my-teams-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.my-team-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}
.my-team-item:last-child { border-bottom: none; }
.team-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.team-info { flex: 1; }
.team-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 8rpx; }
.team-meta { font-size: 24rpx; color: #999; }
.team-role {
  font-size: 22rpx;
  color: #FF6B00;
  background: #FFE8D6;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
