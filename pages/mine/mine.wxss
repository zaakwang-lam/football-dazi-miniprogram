/* pages/mine/mine.wxss */
.page { padding: 24rpx; min-height: 100vh; box-sizing: border-box; background: #F5F6F8; }

/* 未登录 */
.login-entry {
  display: flex; align-items: center; background: #FFFFFF; border-radius: 28rpx;
  padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04);
}
.login-entry-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1E8;
  display:flex; align-items:center; justify-content:center; font-size:46rpx; margin-right:24rpx;
}
.login-entry-info { flex: 1; }
.login-entry-title { font-size:32rpx; font-weight:700; color:#1A1A1A; margin-bottom:8rpx; }
.login-entry-desc { font-size:23rpx; color:#999999; line-height:1.5; }
.login-entry-arrow { font-size:40rpx; color:#C8C8C8; }

/* 已登录用户 */
.user-card {
  display:flex; align-items:center; background:linear-gradient(135deg,#FF6B00,#FF8C42);
  padding:36rpx 30rpx; border-radius:30rpx; margin-bottom:20rpx; color:#FFFFFF;
  box-shadow:0 8rpx 24rpx rgba(255,107,0,.16);
}
.user-avatar {
  width:112rpx; height:112rpx; border-radius:50%; background:rgba(255,255,255,.24);
  display:flex; align-items:center; justify-content:center; margin-right:24rpx;
  overflow:hidden; border:4rpx solid rgba(255,255,255,.35);
}
.user-avatar image { width:100%; height:100%; }
.user-avatar.placeholder { font-size:54rpx; }
.user-info { flex:1; min-width:0; }
.user-name { font-size:36rpx; font-weight:700; margin-bottom:8rpx; }
.user-role {
  display:inline-block; font-size:23rpx; background:rgba(255,255,255,.18);
  padding:6rpx 16rpx; border-radius:999rpx;
}
.user-actions { display:flex; align-items:center; margin-top:14rpx; }
.login-btn {
  display:inline-block; background:#FFFFFF; color:#FF6B00; padding:8rpx 20rpx;
  border-radius:999rpx; font-size:23rpx; font-weight:600;
}
.logout-btn {
  display:inline-block; margin-left:14rpx; background:rgba(255,255,255,.18); color:#FFFFFF;
  padding:8rpx 20rpx; border-radius:999rpx; font-size:23rpx; border:1rpx solid rgba(255,255,255,.38);
}

/* 资料编辑面板 */
.profile-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 1000;
}
.profile-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001;
  background: #FFFFFF; border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.08);
}
.profile-panel-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; text-align: center; }
.profile-panel-sub { font-size: 24rpx; color: #999; text-align: center; margin: 10rpx 0 28rpx; }
.profile-avatar-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 28rpx; }
.avatar-choose-btn {
  flex: 1; margin: 0; padding: 20rpx; background: #FFF8F2; border-radius: 20rpx;
  border: 2rpx solid #FFE0C8; display: flex; flex-direction: column; align-items: center;
  line-height: 1.2;
}
.avatar-choose-btn::after { border: none; }
.avatar-preview {
  width: 96rpx; height: 96rpx; border-radius: 50%; overflow: hidden;
  background: #FFE8D6; margin-bottom: 12rpx;
}
.avatar-preview.placeholder {
  display: flex; align-items: center; justify-content: center; font-size: 42rpx;
}
.avatar-choose-text { font-size: 24rpx; color: #FF6B00; font-weight: 600; }
.avatar-album-btn {
  flex: 1; height: 148rpx; border-radius: 20rpx; background: #F5F6F8;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #333; font-weight: 600; border: 2rpx solid #EEEEEE;
}
.profile-nick-label { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.profile-nick-input {
  height: 80rpx; padding: 0 24rpx; background: #F5F6F8; border-radius: 16rpx;
  font-size: 28rpx; color: #1A1A1A; margin-bottom: 28rpx;
}
.profile-actions { display: flex; gap: 20rpx; }
.profile-btn {
  flex: 1; height: 80rpx; border-radius: 999rpx; display: flex;
  align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600;
}
.profile-btn.cancel { background: #F5F6F8; color: #666; }
.profile-btn.primary { background: #FF6B00; color: #FFFFFF; }

/* 身份选择 */
.register-card {
  background:#FFFFFF; border-radius:26rpx; padding:30rpx 24rpx; margin-bottom:20rpx;
  box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);
}
.register-title { font-size:31rpx; font-weight:700; color:#1A1A1A; text-align:center; }
.register-sub { font-size:23rpx; color:#999; text-align:center; margin:8rpx 0 24rpx; }
.register-options { display:flex; gap:20rpx; }
.register-option {
  flex:1; background:#FFF8F2; border-radius:20rpx; padding:28rpx 12rpx;
  text-align:center; border:2rpx solid #FFF0E5;
}
.register-option:active { border-color:#FF6B00; background:#FFF1E8; }
.register-icon { font-size:58rpx; margin-bottom:12rpx; }
.register-name { font-size:29rpx; font-weight:600; color:#333; margin-bottom:6rpx; }
.register-desc { font-size:21rpx; color:#999; line-height:1.5; }

/* 菜单 */
.menu-card, .my-teams-card {
  background:#FFFFFF; border-radius:24rpx; margin-bottom:20rpx; padding:0 30rpx;
  box-shadow:0 4rpx 16rpx rgba(0,0,0,.035);
}
.menu-section-title { font-size:23rpx; color:#999; padding:22rpx 0 6rpx; }
.menu-row {
  display:flex; align-items:center; min-height:86rpx; padding:14rpx 0;
  box-sizing:border-box; border-bottom:2rpx solid #F5F6F8;
}
.menu-row:last-child { border-bottom:none; }
.menu-icon {
  width:58rpx; height:58rpx; border-radius:16rpx; display:flex; align-items:center;
  justify-content:center; font-size:27rpx; margin-right:20rpx; background:#FFE8D6;
}
.icon-team { background:#E6F2FF; } .icon-join { background:#EEF7FF; }
.icon-create { background:#FFF1E8; } .icon-court { background:#E8F8EE; }
.icon-info { background:#F0E8FF; } .icon-publish { background:#FFF7E6; }
.icon-list { background:#E8F8EE; } .icon-switch { background:#E8F2FF; }
.menu-label { flex:1; font-size:28rpx; color:#1A1A1A; font-weight:500; }
.menu-arrow { font-size:34rpx; color:#CCCCCC; }
.status-tag { padding:4rpx 14rpx; border-radius:999rpx; font-size:21rpx; margin-right:12rpx; }
.status-ok { background:#E8F8EE; color:#2ECC71; }
.status-pending { background:#FFF7E6; color:#FF9500; }

/* 我的球队 */
.my-teams-card { padding:0 30rpx; }
.my-team-item { display:flex; align-items:center; padding:18rpx 0; border-bottom:2rpx solid #F5F5F5; }
.my-team-item:last-child { border-bottom:none; }
.team-logo {
  width:72rpx; height:72rpx; border-radius:50%; background:#FFF1E8; color:#FF6B00;
  font-size:32rpx; font-weight:700; display:flex; align-items:center; justify-content:center; margin-right:20rpx;
  overflow: hidden; position: relative;
}
.team-info { flex:1; min-width:0; }
.team-name { font-size:29rpx; font-weight:600; color:#1A1A1A; margin-bottom:6rpx; }
.team-meta { font-size:22rpx; color:#999; }
.team-role { font-size:21rpx; color:#FF6B00; background:#FFF1E8; padding:4rpx 10rpx; border-radius:999rpx; margin-right:12rpx; }
.team-logo image { width: 100%; height: 100%; }
.team-logo-hint { font-size: 20rpx; color: #FF6B00; margin-top: 4rpx; }
