<!-- pages/mine/mine.wxml -->
<view class="page">
  <view class="login-entry" wx:if="{{!userInfo}}" bindtap="onLogin">
    <view class="login-entry-avatar">⚽</view>
    <view class="login-entry-info">
      <view class="login-entry-title">登录一起搭球</view>
      <view class="login-entry-desc">微信一键登录，开始组队、约战、订场</view>
    </view>
    <text class="login-entry-arrow">›</text>
  </view>

  <view class="login-entry" wx:elif="{{needSelectRole}}" bindtap="onSelectRolePage">
    <view class="login-entry-avatar">⚽</view>
    <view class="login-entry-info">
      <view class="login-entry-title">请选择您的身份</view>
      <view class="login-entry-desc">个人用户或球场方，选择后才能使用完整功能</view>
    </view>
    <text class="login-entry-arrow">›</text>
  </view>

  <view class="user-card" wx:else>
    <view class="user-avatar" wx:if="{{userInfo.avatarUrl}}" bindtap="onAvatarTap">
      <image src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    </view>
    <view class="user-avatar placeholder" wx:else bindtap="onAvatarTap">👤</view>
    <view class="user-info">
      <view class="user-name">{{userInfo.nickName || userInfo.nickname || '微信用户'}}</view>
      <view class="user-role" wx:if="{{currentRole === 'user'}}">👤 个人用户</view>
      <view class="user-role" wx:if="{{currentRole === 'court'}}">🏟 球场方</view>
      <view class="user-actions">
        <view class="login-btn" bindtap="onEditNickname">✏️ 修改资料</view>
        <view class="logout-btn" bindtap="onLogout">退出登录</view>
      </view>
    </view>
  </view>

  <view class="profile-mask" wx:if="{{showProfilePanel}}" bindtap="onCloseProfilePanel"></view>
  <view class="profile-panel" wx:if="{{showProfilePanel}}">
    <view class="profile-panel-title">完善头像和昵称</view>
    <view class="profile-panel-sub">微信已不再返回真实头像昵称，请手动选择</view>
    <view class="profile-avatar-row">
      <button class="avatar-choose-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseWechatAvatar">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-preview" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-preview placeholder">👤</view>
        <text class="avatar-choose-text">选微信头像</text>
      </button>
      <view class="avatar-album-btn" bindtap="onChooseLocalAvatar">从相册选择</view>
    </view>
    <view class="profile-nick-label">昵称</view>
    <input class="profile-nick-input" type="nickname" maxlength="20" placeholder="请输入昵称" value="{{draftNickname}}" bindinput="onDraftNicknameInput" bindblur="onDraftNicknameInput" />
    <view class="profile-actions">
      <view class="profile-btn cancel" bindtap="onCloseProfilePanel">取消</view>
      <view class="profile-btn primary" bindtap="onSaveNickname">保存昵称</view>
    </view>
  </view>

  <view class="register-card" wx:if="{{needSelectRole}}">
    <view class="register-title">选择您的身份</view>
    <view class="register-sub">选择后才能使用完整功能</view>
    <view class="register-options">
      <view class="register-option" bindtap="onRegisterTap" data-role="user">
        <view class="register-icon">👤</view>
        <view class="register-name">个人用户</view>
        <view class="register-desc">发起组队、加入约战、订场</view>
      </view>
      <view class="register-option" bindtap="onRegisterTap" data-role="court">
        <view class="register-icon">🏟</view>
        <view class="register-name">球场方</view>
        <view class="register-desc">登记球场、发布空闲时段</view>
      </view>
    </view>
  </view>

  <view class="menu-card" wx:if="{{currentRole === 'user'}}">
    <view class="menu-section-title">我的服务</view>
    <view class="menu-row" bindtap="onMenuTap" data-type="order">
      <view class="menu-icon icon-list">📋</view>
      <text class="menu-label">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-section-title">我的组队</view>
    <view class="menu-row" bindtap="onMenuTap" data-type="my-teams">
      <view class="menu-icon icon-team">⚽</view>
      <text class="menu-label">我发起的组队</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onMenuTap" data-type="joined-teams">
      <view class="menu-icon icon-join">👥</view>
      <text class="menu-label">我加入的组队</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onMenuTap" data-type="create-team">
      <view class="menu-icon icon-create">➕</view>
      <text class="menu-label">发起组队</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onMenuTap" data-type="join-team">
      <view class="menu-icon icon-join">👥</view>
      <text class="menu-label">加入已发起组队</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{hasCourt}}" bindtap="onSwitchRole">
      <view class="menu-icon icon-switch">🔄</view>
      <text class="menu-label">切换到球场方</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card" wx:if="{{currentRole === 'court'}}">
    <view class="menu-section-title">球场管理</view>
    <view class="menu-row" bindtap="onMenuTap" data-type="court-info">
      <view class="menu-icon icon-court">🏟</view>
      <text class="menu-label">球场信息</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onMenuTap" data-type="publish-slot">
      <view class="menu-icon icon-publish">📅</view>
      <text class="menu-label">发布空闲时段</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onMenuTap" data-type="court-orders">
      <view class="menu-icon icon-list">📋</view>
      <text class="menu-label">订单管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{hasUser}}" bindtap="onSwitchRole">
      <view class="menu-icon icon-switch">🔄</view>
      <text class="menu-label">切换到个人用户</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="my-teams-card" wx:if="{{currentRole === 'user' && myTeams.length > 0}}">
    <view class="menu-section-title">我的球队</view>
    <view class="my-team-item" wx:for="{{myTeams}}" wx:key="id" bindtap="onMyTeamTap" data-id="{{item.id}}">
      <view class="team-logo" catchtap="onUploadTeamLogo" data-id="{{item.id}}" data-role="{{item.role}}">
        <image wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill" />
        <text wx:else>{{item.name[0] || '⚽'}}</text>
      </view>
      <view class="team-info">
        <view class="team-name">{{item.name}}</view>
        <view class="team-meta">{{item.district || '广州'}} · {{item.memberCount || 1}} 人 · {{item.attendance || 0}} 场出勤</view>
        <view class="team-logo-hint" wx:if="{{item.role === 'captain'}}">点队徽可上传球队图片</view>
      </view>
      <view class="team-role" wx:if="{{item.role === 'captain'}}">队长</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
