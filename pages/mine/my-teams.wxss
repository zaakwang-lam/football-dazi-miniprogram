/* pages/mine/my-teams.wxss */
.page { min-height: 100vh; background: #F5F5F5; padding-bottom: 120rpx; }
.tabs {
  display: flex; background: #fff; padding: 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0; position: sticky; top: 0; z-index: 10;
}
.tab {
  flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; color: #666;
  position: relative;
}
.tab.active { color: #FF6B00; font-weight: 600; }
.tab.active::after {
  content: ''; position: absolute; left: 30%; right: 30%; bottom: 0;
  height: 4rpx; background: #FF6B00; border-radius: 4rpx;
}
.lfg-list { padding: 24rpx; }
.lfg-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.card-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.card-type {
  display: flex; align-items: center; gap: 6rpx; font-size: 22rpx;
  padding: 4rpx 14rpx; border-radius: 999rpx;
}
.type-sub { background: #E8F5E9; color: #2E7D32; }
.type-war { background: #FFF3E0; color: #EF6C00; }
.card-role {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx;
  background: #FFE8D6; color: #FF6B00;
}
.card-role.joiner { background: #E3F2FD; color: #1565C0; }
.card-time { margin-left: auto; font-size: 22rpx; color: #999; }
.team-name { font-size: 30rpx; font-weight: 700; color: #1A1A1A; }
.need-num { font-size: 24rpx; color: #FF6B00; font-weight: 600; }
.main-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.main-info { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 8rpx; }
.info-item { font-size: 22rpx; color: #666; }
.main-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.card-bottom {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f5f5f5;
}
.contact-info { font-size: 24rpx; color: #666; }
.status-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.status-open, .status-tag.status-open { background: #E8F5E9; color: #2E7D32; }
.status-full { background: #FFF3E0; color: #EF6C00; }
.status-closed { background: #ECEFF1; color: #607D8B; }
.card-actions {
  margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #f5f5f5;
  display: flex; justify-content: flex-end;
}
.action-del {
  padding: 12rpx 28rpx; font-size: 26rpx; color: #FF4757;
  background: #FFEBEE; border-radius: 999rpx;
}
.empty { text-align: center; padding: 120rpx 0; color: #999; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
.empty-tip { font-size: 24rpx; margin-top: 12rpx; color: #bbb; }
.fab {
  position: fixed; right: 40rpx; bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FF6B00, #FF8C42); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; box-shadow: 0 8rpx 24rpx rgba(255,107,0,0.4);
}
