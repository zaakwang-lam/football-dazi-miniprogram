<!-- pages/mine/court-register.wxml -->
<view class="page">
  <view class="form-tip">先输入球场名称。若系统已收录该球场，点「认领」即可关联并编辑；没有收录再填写资料提交审核。</view>

  <view class="form-section">
    <view class="form-label required">球场名称</view>
    <input class="form-input" placeholder="如：白云新海足球场" value="{{form.name}}" bindinput="onInput" data-field="name" />

    <view class="match-box" wx:if="{{searching || matches.length}}">
      <view class="match-hint" wx:if="{{searching && !matches.length}}">正在匹配已收录球场…</view>
      <view class="match-hint" wx:elif="{{matches.length}}">系统已收录，可直接认领：</view>
      <view class="match-item" wx:for="{{matches}}" wx:key="id">
        <view class="match-info">
          <view class="match-name">{{item.name}}</view>
          <view class="match-addr">{{item.district}} {{item.address}}</view>
        </view>
        <view class="btn-claim" wx:if="{{item.claimState === 'claimable'}}" catchtap="onClaimTap" data-id="{{item.id}}" data-name="{{item.name}}">认领</view>
        <view class="btn-claim mine" wx:elif="{{item.claimState === 'mine'}}" catchtap="onGoMine" data-id="{{item.id}}">去编辑</view>
        <view class="btn-claim taken" wx:else>已被认领</view>
      </view>
    </view>

    <view class="form-label required">支持人制（多选）</view>
    <view class="checkbox-group">
      <view class="checkbox-item {{item.selected ? 'active' : ''}}" wx:for="{{courtTypes}}" wx:key="value" bindtap="onCourtTypeToggle" data-value="{{item.value}}" hover-class="checkbox-item-hover">
        <view class="checkbox {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <text>{{item.value}}</text>
      </view>
    </view>

    <view class="form-label required">场地性质（多选）</view>
    <view class="checkbox-group">
      <view class="checkbox-item {{item.selected ? 'active' : ''}}" wx:for="{{surfaceTypes}}" wx:key="value" bindtap="onSurfaceToggle" data-value="{{item.value}}" hover-class="checkbox-item-hover">
        <view class="checkbox {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <text>{{item.value}}</text>
      </view>
    </view>

    <view class="form-label required">所在地区</view>
    <view class="region-row">
      <picker mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="form-picker region-picker">{{form.province || '省'}}</view>
      </picker>
      <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange">
        <view class="form-picker region-picker">{{form.city || '市'}}</view>
      </picker>
      <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrictChange">
        <view class="form-picker region-picker">{{form.district || '区/县'}}</view>
      </picker>
    </view>
    <view class="loc-hint" wx:if="{{form.regionText}}">已选：{{form.regionText}}</view>

    <view class="form-label required">球场地址</view>
    <view class="addr-row">
      <input class="form-input addr-input" placeholder="点击右侧按钮地图选点，或手动填写" value="{{form.address}}" bindinput="onInput" data-field="address" />
      <view class="btn-map" bindtap="onChooseLocation">地图选点</view>
    </view>
    <view class="loc-hint" wx:if="{{form.latitude && form.longitude}}">
      📍 已选坐标：{{form.latitude}}, {{form.longitude}}
    </view>
    <view class="loc-hint" wx:else>📍 建议用地图选点，便于用户按距离查找球场</view>

    <view class="form-label">联系电话</view>
    <input class="form-input" placeholder="如：020-12345678" value="{{form.phone}}" bindinput="onInput" data-field="phone" type="number" />

    <view class="form-label">基础价格（元/场）</view>
    <input class="form-input" placeholder="如：300" value="{{form.price}}" bindinput="onInput" data-field="price" type="digit" />

    <view class="form-label">球场宣传图片</view>
    <view class="cover-block">
      <image wx:if="{{coverLocal || coverUrl}}" class="cover-preview" src="{{coverLocal || coverUrl}}" mode="aspectFill"></image>
      <view wx:else class="cover-placeholder" bindtap="onChooseCover">
        <view class="cover-icon">📷</view>
        <text>点击上传球场宣传图</text>
      </view>
      <view class="cover-actions">
        <button class="btn-cover" bindtap="onChooseCover">{{coverLocal || coverUrl ? '重新选择' : '选择图片'}}</button>
        <view wx:if="{{coverLocal || coverUrl}}" class="btn-cover-clear" bindtap="onClearCover">清除</view>
      </view>
    </view>

    <view class="form-label">开放时间（按周设置，可添加多个时段）</view>
    <view class="open-hours-list">
      <view class="open-hours-day" wx:for="{{weekDays}}" wx:key="key" wx:for-item="day">
        <view class="day-header">
          <text class="day-name">{{day.label}}</text>
          <view class="add-slot" bindtap="onAddSlot" data-day="{{day.key}}">+ 添加时段</view>
        </view>
        <view wx:if="{{form.openHours[day.key] && form.openHours[day.key].length > 0}}">
          <view class="time-row" wx:for="{{form.openHours[day.key]}}" wx:key="index" wx:for-item="slot" wx:for-index="slotIdx">
            <picker mode="time" value="{{slot.start}}" bindchange="onSlotTimeChange" data-day="{{day.key}}" data-idx="{{slotIdx}}" data-field="start">
              <view class="time-picker">{{slot.start || '开始'}}</view>
            </picker>
            <text class="time-sep">至</text>
            <picker mode="time" value="{{slot.end}}" bindchange="onSlotTimeChange" data-day="{{day.key}}" data-idx="{{slotIdx}}" data-field="end">
              <view class="time-picker">{{slot.end || '结束'}}</view>
            </picker>
            <view class="del-slot" bindtap="onDelSlot" data-day="{{day.key}}" data-idx="{{slotIdx}}">✕</view>
          </view>
        </view>
        <view wx:else class="empty-slot">未开放</view>
      </view>
    </view>

    <view class="form-label">球场简介</view>
    <textarea class="form-textarea" placeholder="如：交通便利、有停车场、有更衣室" value="{{form.description}}" bindinput="onInput" data-field="description" maxlength="200" />
  </view>

  <view class="form-actions">
    <button class="btn-submit" bindtap="onSubmit">提交审核</button>
  </view>
</view>
