<!-- pages/mine/lfg-publish.wxml -->
<view class="page">
  <view class="form-tip">发起一个组队活动，其他个人可报名加入</view>

  <view class="form-section" wx:if="{{ready}}" style="margin-bottom: 0; padding-bottom: 0;">
    <view class="form-label required">球队名称</view>
    <picker wx:if="{{myTeams.length > 1}}" mode="selector" range="{{myTeams}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamPick">
      <view class="form-input">{{form.teamName}} ›</view>
    </picker>
    <input wx:else class="form-input" disabled value="{{form.teamName}}" />
    <view style="font-size:22rpx;color:#999;margin-top:8rpx;">仅已加入球队可发起，队名自动带入</view>
  </view>

  <view class="form-section">
    <view class="form-label required">人制（多选）</view>
    <view class="checkbox-group">
      <view class="checkbox-item {{form.matchTypes.indexOf(item) >= 0 ? 'active' : ''}}" wx:for="{{teamTypes}}" wx:key="*this" bindtap="onTeamTypeToggle" data-value="{{item}}">
        <view class="checkbox {{form.matchTypes.indexOf(item) >= 0 ? 'checked' : ''}}">{{form.matchTypes.indexOf(item) >= 0 ? '✓' : ''}}</view>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="form-label required">场地位置</view>
    <view class="loc-row">
      <input class="form-input loc-flex" placeholder="点击右侧地图选点" value="{{form.location}}" disabled />
      <view class="btn-map" bindtap="onChooseLocation">地图选点</view>
    </view>

    <view class="form-label required">比赛时间</view>
    <view class="time-row">
      <picker mode="date" value="{{form.dateValue}}" start="{{dateMin}}" end="{{dateMax}}" bindchange="onDateChange">
        <view class="time-cell">
          <text wx:if="{{form.dateText}}">{{form.dateText}}</text>
          <text wx:else class="ph">选日期</text>
        </view>
      </picker>
      <picker mode="time" value="{{form.timeValue}}" bindchange="onTimeChange">
        <view class="time-cell">
          <text wx:if="{{form.timeText}}">{{form.timeText}}</text>
          <text wx:else class="ph">选时间</text>
        </view>
      </picker>
    </view>

    <view class="form-label required">空闲名额</view>
    <view class="count-row">
      <view class="count-btn" bindtap="onCountChange" data-delta="-1">-</view>
      <text class="count-num">{{form.needCount}}</text>
      <view class="count-btn" bindtap="onCountChange" data-delta="1">+</view>
      <text class="count-unit">人</text>
    </view>

    <view class="form-label">人均费用（元，选填）</view>
    <input class="form-input" placeholder="如：30" value="{{form.fee}}" bindinput="onInput" data-field="fee" type="digit" />

    <view class="form-label required">联系手机</view>
    <input class="form-input" type="number" maxlength="11" placeholder="请输入11位手机号码" value="{{form.contact}}" bindinput="onInput" data-field="contact" />

    <view class="form-label">备注</view>
    <textarea class="form-textarea" placeholder="如：水平不限，欢迎新人" value="{{form.description}}" bindinput="onInput" data-field="description" maxlength="200" />
  </view>

  <view class="form-actions">
    <button class="btn-submit" bindtap="onSubmit">发布</button>
  </view>
</view>
