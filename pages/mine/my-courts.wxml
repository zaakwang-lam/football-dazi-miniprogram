<!-- pages/mine/my-courts.wxml -->
<view class="page">
  <view class="empty-state" wx:if="{{!loading && courts.length === 0}}">
    <view class="empty-icon">🏟</view>
    <view class="empty-title">暂无球场</view>
    <view class="empty-desc">登记球场后可在此查看与编辑信息</view>
    <button class="btn-register" bindtap="onRegisterTap">登记新球场</button>
  </view>

  <view class="loading-state" wx:if="{{loading}}"><text>加载中...</text></view>

  <view class="court-list" wx:if="{{courts.length > 0}}">
    <view class="court-card" wx:for="{{courts}}" wx:key="id">
      <image wx:if="{{item.coverUrl}}" class="court-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="card-header">
        <text class="court-name">{{item.name}}</text>
        <view class="status-tag status-{{item.statusCls}}">{{item.statusLabel}}</view>
      </view>
      <view class="card-row"><text class="icon">📍</text><text class="district">{{item.district || '未设置'}}</text><text class="address">· {{item.address}}</text></view>
      <view class="card-row"><text class="icon">📞</text><text>{{item.phone || '未设置联系电话'}}</text></view>
      <view class="card-row"><text class="icon">💰</text><text>{{item.priceText}}</text></view>
      <view class="card-row"><text class="icon">🟢</text><text class="surface">{{item.surfaceTypesText}} · {{item.typesText}}</text></view>
      <view class="card-row" wx:if="{{item.openHoursText}}"><text class="icon">🕐</text><text class="open-hours">{{item.openHoursText}}</text></view>
      <view class="card-row" wx:if="{{item.description}}"><text class="icon">📝</text><text>{{item.description}}</text></view>
      <view class="card-actions">
        <view class="action-btn" bindtap="onEditTap" data-id="{{item.id}}">编辑信息</view>
        <view class="action-btn primary" wx:if="{{item.status === 1}}" bindtap="onPublishSlot" data-id="{{item.id}}">发布空闲</view>
      </view>
      <view class="card-footer"><text class="join-time">登记于 {{item.createdAtText}}</text></view>
    </view>
  </view>

  <view class="edit-mask" wx:if="{{editing}}" bindtap="onCancelEdit"></view>
  <view class="edit-panel" wx:if="{{editing}}">
    <view class="edit-title">编辑球场信息</view>

    <view class="edit-label">球场图片（1 张）</view>
    <view class="cover-row">
      <view class="cover-box" bindtap="onChooseCover">
        <image
          wx:if="{{editForm.localPreview || editForm.coverUrl}}"
          class="cover-preview"
          src="{{editForm.localPreview || editForm.coverUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="cover-placeholder">
          <text class="cover-plus">+</text>
          <text class="cover-tip">上传图片</text>
        </view>
      </view>
      <view class="cover-actions">
        <view class="cover-btn" bindtap="onChooseCover">选择图片</view>
        <view class="cover-btn ghost" wx:if="{{editForm.localPreview || editForm.coverUrl}}" bindtap="onRemoveCover">清除</view>
      </view>
    </view>

    <view class="edit-label">球场名称</view>
    <input class="edit-input" value="{{editForm.name}}" data-field="name" bindinput="onEditInput" placeholder="球场名称" />
    <view class="edit-label">地址</view>
    <view class="addr-row">
      <input class="edit-input addr-flex" value="{{editForm.address}}" data-field="address" bindinput="onEditInput" placeholder="详细地址" />
      <view class="btn-map-sm" bindtap="onEditChooseLocation">地图选点</view>
    </view>
    <view class="loc-hint" wx:if="{{editForm.latitude && editForm.longitude}}">坐标 {{editForm.latitude}}, {{editForm.longitude}}</view>
    <view class="edit-label">人制类型（可多选）</view>
    <view class="checkbox-group">
      <view
        class="checkbox-item {{item.selected ? 'active' : ''}}"
        wx:for="{{editCourtTypes}}"
        wx:key="value"
        bindtap="onEditTypeToggle"
        data-value="{{item.value}}"
      >
        <view class="checkbox {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <text>{{item.value}}</text>
      </view>
    </view>
    <view class="edit-label">联系电话</view>
    <input class="edit-input" type="number" maxlength="20" value="{{editForm.phone}}" data-field="phone" bindinput="onEditInput" placeholder="联系电话" />
    <view class="edit-label">场地费用（元/场）</view>
    <input class="edit-input" type="digit" value="{{editForm.price}}" data-field="price" bindinput="onEditInput" placeholder="例如 300" />
    <view class="edit-label">球场简介</view>
    <textarea class="edit-textarea" value="{{editForm.description}}" data-field="description" bindinput="onEditInput" placeholder="交通、停车、更衣室等" maxlength="500" />
    <view class="edit-actions">
      <view class="edit-btn cancel" bindtap="onCancelEdit">取消</view>
      <view class="edit-btn primary" bindtap="onSaveEdit">保存</view>
    </view>
  </view>
</view>
