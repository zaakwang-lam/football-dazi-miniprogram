<!-- pages/mine/my-courts.wxml -->
<view class="page">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && courts.length === 0}}">
    <view class="empty-icon">🏟</view>
    <view class="empty-title">暂无已审核球场</view>
    <view class="empty-desc">球场信息审核通过后会在这里显示</view>
    <button class="btn-register" bindtap="onRegisterTap">登记新球场</button>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 球场列表（按加入时间倒序） -->
  <view class="court-list" wx:if="{{courts.length > 0}}">
    <view class="court-card" wx:for="{{courts}}" wx:key="id" bindtap="onCourtTap" data-id="{{item.id}}">
      <view class="card-header">
        <text class="court-name">{{item.name}}</text>
        <view class="status-tag status-ok">已营业</view>
      </view>

      <view class="card-row">
        <text class="icon">📍</text>
        <text class="district">{{item.district || '未设置'}}</text>
        <text class="address">· {{item.address}}</text>
      </view>

      <view class="card-row">
        <text class="icon">🟢</text>
        <text class="surface">{{item.surfaceTypesText}}</text>
      </view>

      <view class="card-row" wx:if="{{item.openHoursText}}">
        <text class="icon">🕐</text>
        <text class="open-hours">{{item.openHoursText}}</text>
      </view>

      <view class="card-footer">
        <text class="join-time">加入于 {{item.createdAtText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>