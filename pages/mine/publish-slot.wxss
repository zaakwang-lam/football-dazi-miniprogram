.page { min-height: 100vh; background: #f5f5f5; padding: 24rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 24rpx;
}
.label { font-size: 24rpx; color: #888; margin: 16rpx 0 8rpx; }
.label.required::before { content: '* '; color: #FF4757; }
.picker-val, .input {
  background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx;
}
.type-row { display: flex; gap: 16rpx; }
.type-chip {
  flex: 1; text-align: center; padding: 18rpx 0;
  background: #f5f5f5; color: #666; border-radius: 12rpx; font-size: 26rpx;
}
.type-chip.active { background: #E8EEFF; color: #1B4FD8; font-weight: 600; }
.btn-primary {
  margin-top: 32rpx; background: #1B4FD8; color: #fff; text-align: center;
  padding: 24rpx; border-radius: 48rpx; font-size: 30rpx;
}
.section-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.slot-row {
  display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0; font-size: 26rpx; color: #333;
}
.slot-main { display: flex; flex-direction: column; gap: 4rpx; }
.slot-type { font-size: 22rpx; color: #1B4FD8; }
.price { color: #1B4FD8; font-weight: 600; }

.time-row { display: flex; align-items: center; gap: 16rpx; }
.time-picker { flex: 1; text-align: center; }
.time-sep { color: #999; font-size: 26rpx; }
.time-hint { margin-top: 8rpx; font-size: 22rpx; color: #999; }
