/* pages/mine/court-register.wxss */
.page { padding: 24rpx; padding-bottom: 160rpx; }
.form-tip {
  background: #FFF7E6; color: #AD6800; font-size: 24rpx; padding: 20rpx 24rpx;
  border-radius: 16rpx; margin-bottom: 24rpx; line-height: 1.5;
}
.form-section {
  background: #fff; border-radius: 24rpx; padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.form-label {
  font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; font-weight: 500;
}
.form-label.required::before { content: '* '; color: #FF4757; }
.form-input, .form-picker {
  background: #F5F7FA; border-radius: 16rpx;
  min-height: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  font-size: 30rpx; color: #1A1A1A; width: 100%; box-sizing: border-box;
}
.form-textarea {
  background: #F5F7FA; border-radius: 16rpx; padding: 24rpx 28rpx;
  font-size: 30rpx; color: #1A1A1A; width: 100%; box-sizing: border-box;
  min-height: 180rpx; line-height: 1.5; height: auto;
}
.cover-block {
  display: flex; flex-direction: column; align-items: flex-start; gap: 16rpx;
}
.cover-preview {
  width: 100%; height: 320rpx; border-radius: 16rpx; background: #F5F7FA;
}
.cover-placeholder {
  width: 100%; height: 320rpx; border-radius: 16rpx; background: #F5F7FA;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #999; font-size: 26rpx; border: 2rpx dashed #DDD; box-sizing: border-box;
}
.cover-placeholder .cover-icon { font-size: 56rpx; margin-bottom: 12rpx; }
.cover-actions { display: flex; gap: 16rpx; width: 100%; }
.btn-cover {
  flex: 1; height: 72rpx; line-height: 72rpx; text-align: center;
  background: #FFE8D6; color: #FF6B00; border-radius: 16rpx; font-size: 26rpx; font-weight: 600;
  border: none;
}
.btn-cover::after { border: none; }
.btn-cover-clear {
  flex: 0 0 140rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  background: #F5F7FA; color: #999; border-radius: 16rpx; font-size: 26rpx;
}
.checkbox-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.checkbox-item {
  display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx;
  background: #F5F7FA; border-radius: 999rpx; font-size: 26rpx; color: #666;
}
.checkbox-item.active { background: #FFE8D6; color: #FF6B00; font-weight: 600; }
.checkbox {
  width: 28rpx; height: 28rpx; border: 2rpx solid #CCC; border-radius: 6rpx;
  display: flex; align-items: center; justify-content: center; font-size: 18rpx; color: #fff;
}
.checkbox.checked { background: #FF6B00; border-color: #FF6B00; }

.addr-row { display: flex; gap: 16rpx; align-items: center; }
.addr-input { flex: 1; }
.btn-map {
  flex-shrink: 0; padding: 20rpx 24rpx; background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #fff; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; white-space: nowrap;
}
.loc-hint { margin-top: 12rpx; font-size: 22rpx; color: #999; }

.open-hours-list { margin-top: 8rpx; }
.open-hours-day {
  background: #F5F7FA; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx;
}
.day-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.day-name { font-size: 26rpx; font-weight: 600; color: #333; }
.add-slot { font-size: 24rpx; color: #FF6B00; }
.time-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.time-picker {
  background: #fff; padding: 10rpx 20rpx; border-radius: 12rpx; font-size: 26rpx; color: #333;
}
.time-sep { color: #999; font-size: 24rpx; }
.del-slot { color: #FF4757; font-size: 28rpx; padding: 0 8rpx; }
.empty-slot { font-size: 24rpx; color: #BBB; }

.form-actions {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.btn-submit {
  background: linear-gradient(135deg, #FF6B00, #FF8C42); color: #fff; border-radius: 999rpx;
  font-size: 30rpx; font-weight: 600; height: 88rpx; line-height: 88rpx; border: none;
}
.btn-submit::after { border: none; }
