<view class="page">
  <view class="card">
    <view class="label">选择球场</view>
    <picker mode="selector" range="{{courts}}" range-key="name" value="{{courtIndex}}" bindchange="onCourtChange">
      <view class="picker-val">{{courts[courtIndex].name || '请选择'}}</view>
    </picker>

    <view class="label required">球场类型</view>
    <view class="type-row">
      <view
        class="type-chip {{pitchType === item ? 'active' : ''}}"
        wx:for="{{pitchTypes}}"
        wx:key="*this"
        bindtap="onPitchTypeTap"
        data-value="{{item}}"
      >{{item}}</view>
    </view>

    <view class="label">日期</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-val">{{date}}</view>
    </picker>

    <view class="label">时段</view>
    <view class="time-row">
      <picker mode="time" value="{{startTime}}" bindchange="onStartTime">
        <view class="picker-val time-picker">{{startTime}}</view>
      </picker>
      <text class="time-sep">至</text>
      <picker mode="time" value="{{endTime}}" bindchange="onEndTime">
        <view class="picker-val time-picker">{{endTime}}</view>
      </picker>
    </view>
    <view class="time-hint">已选 {{timeSlot}}，点击时间滚动选择</view>

    <view class="label required">场次费用（元）</view>
    <input class="input" type="digit" value="{{price}}" bindinput="onPriceInput" placeholder="例如 300" />

    <view class="btn-primary" bindtap="onPublish">{{editingId ? '保存修改' : '发布空闲时段'}}</view>
    <view class="btn-cancel" wx:if="{{editingId}}" bindtap="onCancelEdit">取消修改</view>
  </view>

  <view class="card" wx:if="{{slots.length}}">
    <view class="section-title">已发布空闲</view>
    <view class="slot-row" wx:for="{{slots}}" wx:key="id">
      <view class="slot-main">
        <text>{{item.date}} {{item.timeSlot}}</text>
        <text class="slot-type">{{item.pitchType || '5人场'}}</text>
      </view>
      <view class="slot-side">
        <text class="price">¥{{item.price}}</text>
        <text class="slot-edit" catchtap="onEditSlot" data-id="{{item.id}}">修改</text>
        <text class="slot-del" catchtap="onDeleteSlot" data-id="{{item.id}}" data-label="{{item.date}} {{item.timeSlot}}">删除</text>
      </view>
    </view>
  </view>
</view>
