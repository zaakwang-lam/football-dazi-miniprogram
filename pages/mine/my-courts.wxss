/* pages/mine/my-courts.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-register {
  background: #FF6B00;
  color: white;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  display: inline-block;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 球场列表 */
.court-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.court-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.court-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.status-tag.status-ok {
  background: #e8f5e9;
  color: #2e7d32;
}

.card-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.card-row .icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.card-row .district {
  color: #FF6B00;
  font-weight: bold;
  margin-right: 8rpx;
}

.card-row .address {
  color: #666;
  flex: 1;
  word-break: break-all;
}

.card-row .surface {
  color: #555;
}

.card-row .open-hours {
  color: #555;
  font-size: 24rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.join-time {
  font-size: 22rpx;
  color: #999;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}