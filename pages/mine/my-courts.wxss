/* pages/mine/my-courts.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; color: #333; font-weight: bold; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #999; margin-bottom: 40rpx; }
.btn-register {
  background: #FF6B00; color: white; border-radius: 48rpx;
  font-size: 28rpx; padding: 16rpx 48rpx; display: inline-block;
}
.loading-state { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }

.court-list { display: flex; flex-direction: column; gap: 20rpx; }
.court-card {
  background: white; border-radius: 16rpx; padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.card-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0;
}
.court-name { font-size: 32rpx; font-weight: bold; color: #333; flex: 1; }
.status-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx; margin-left: 12rpx; }
.status-tag.status-ok { background: #e8f5e9; color: #2e7d32; }
.status-tag.status-pending { background: #fff3e0; color: #ef6c00; }
.status-tag.status-reject { background: #ffebee; color: #c62828; }
.status-tag.status-off { background: #eceff1; color: #607d8b; }

.card-row {
  display: flex; align-items: flex-start; margin-bottom: 12rpx;
  font-size: 26rpx; color: #666; line-height: 1.6;
}
.card-row .icon { margin-right: 12rpx; flex-shrink: 0; }
.card-row .district { color: #FF6B00; font-weight: bold; margin-right: 8rpx; }

.card-actions {
  display: flex; gap: 16rpx; margin-top: 20rpx; padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.action-btn {
  flex: 1; text-align: center; font-size: 26rpx; padding: 16rpx 0;
  border-radius: 12rpx; background: #f5f5f5; color: #333;
}
.action-btn.primary { background: #FF6B00; color: #fff; }

.card-footer { margin-top: 12rpx; }
.join-time { font-size: 22rpx; color: #999; }

.edit-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 100;
}
.edit-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx 48rpx; z-index: 101;
}
.edit-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; }
.edit-label { font-size: 24rpx; color: #888; margin: 16rpx 0 8rpx; }
.edit-input {
  background: #f5f5f5; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx;
}
.edit-textarea {
  background: #f5f5f5; border-radius: 12rpx; padding: 18rpx 20rpx;
  font-size: 28rpx; width: 100%; min-height: 160rpx; box-sizing: border-box;
}
.edit-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.edit-btn {
  flex: 1; text-align: center; padding: 22rpx 0; border-radius: 48rpx; font-size: 28rpx;
}
.edit-btn.cancel { background: #f0f0f0; color: #666; }
.edit-btn.primary { background: #FF6B00; color: #fff; }
