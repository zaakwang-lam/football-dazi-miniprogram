/* pages/team/create.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
}
.form-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.form-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}
.form-input {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  width: 100%;
  padding: 8rpx 0;
}
.form-textarea {
  font-size: 28rpx;
  color: #1A1A1A;
  width: 100%;
  min-height: 160rpx;
  padding: 8rpx 0;
}
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #1A1A1A;
}
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.btn-primary.full {
  display: block;
  width: 100%;
}
.region-row { display: flex; gap: 12rpx; }
.form-picker {
  flex: 1; background: #F5F7FA; border-radius: 16rpx; min-height: 80rpx; line-height: 80rpx;
  text-align: center; font-size: 26rpx; color: #1A1A1A; padding: 0 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.region-hint { margin-top: 12rpx; font-size: 22rpx; color: #999; }
.logo-block { display: flex; flex-direction: column; gap: 16rpx; }
.logo-preview { width: 160rpx; height: 160rpx; border-radius: 24rpx; background: #F5F7FA; }
.logo-placeholder {
  width: 160rpx; height: 160rpx; border-radius: 24rpx; background: #F5F7FA;
  display: flex; align-items: center; justify-content: center;
  color: #999; font-size: 24rpx; border: 2rpx dashed #DDD;
}
.logo-actions { display: flex; gap: 16rpx; }
.btn-logo {
  padding: 12rpx 24rpx; background: #FFE8D6; color: #FF6B00; border-radius: 12rpx; font-size: 24rpx; font-weight: 600;
}
.btn-logo-clear { padding: 12rpx 24rpx; background: #F5F7FA; color: #999; border-radius: 12rpx; font-size: 24rpx; }
