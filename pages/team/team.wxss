/* pages/team/team.wxss */
.page {
  padding: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 我的球队 */
.my-team {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C42 100%);
  color: #FFFFFF;
}

.my-team-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.my-team-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

.my-team-info {
  flex: 1;
}

.my-team-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.my-team-meta {
  font-size: 24rpx;
  opacity: 0.9;
}

.my-team-arrow {
  font-size: 40rpx;
  opacity: 0.7;
}

.data-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.data-item {
  flex: 1;
  text-align: center;
}

.data-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.data-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 无球队 */
.no-team {
  text-align: center;
  padding: 60rpx 32rpx;
}

.no-team-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.no-team-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

/* Section */
.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 600;
}

/* 球队列表 */
.team-list {
  padding: 0 32rpx;
}

.team-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.team-row:last-child {
  border-bottom: none;
}

.team-row-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.team-row-info {
  flex: 1;
  min-width: 0;
}

.team-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.team-row-meta {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.team-row-motto {
  font-size: 22rpx;
  color: #666666;
  font-style: italic;
}