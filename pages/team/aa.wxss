/* pages/team/aa.wxss */
.page {
  padding: 0 0 200rpx;
}

.hero {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  padding: 60rpx 32rpx 80rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 0 0 48rpx 48rpx;
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.amount-card {
  background: #FFFFFF;
  margin: -40rpx 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.amount-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}

.amount-sign {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B00;
  margin-right: 8rpx;
}

.amount-num {
  font-size: 80rpx;
  font-weight: 700;
  color: #FF6B00;
  line-height: 1;
}

.amount-unit {
  font-size: 28rpx;
  color: #999999;
  margin-left: 8rpx;
}

.amount-divider {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.number-picker {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.picker-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFE8D6;
  color: #FF6B00;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.form-textarea {
  font-size: 28rpx;
  color: #1A1A1A;
  width: 100%;
  min-height: 100rpx;
  padding: 8rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 16rpx 32rpx;
}

.member-list {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FACFE, #00F2FE);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.member-status {
  font-size: 24rpx;
}

.member-status.paid {
  color: #2ECC71;
}

.member-status.unpaid {
  color: #FFB800;
}

.member-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B00;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F5F7FA;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-primary.full {
  display: block;
  width: 100%;
}