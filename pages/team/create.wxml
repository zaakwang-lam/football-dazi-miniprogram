<!-- pages/team/create.wxml -->
<view class="page">
  <view class="form-group">
    <view class="form-label">球队名称 *</view>
    <input class="form-input" placeholder="如：越秀老炮队" value="{{form.name}}" bindinput="onInput" data-key="name" />
  </view>

  <view class="form-group">
    <view class="form-label">球队口号</view>
    <input class="form-input" placeholder="如：老炮不老，踢球到老" value="{{form.motto}}" bindinput="onInput" data-key="motto" />
  </view>

  <view class="form-group">
    <view class="form-label">所在区域 *</view>
    <view class="region-row">
      <picker mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="form-picker">{{form.province || '省'}}</view>
      </picker>
      <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange">
        <view class="form-picker">{{form.city || '市'}}</view>
      </picker>
      <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrictChange">
        <view class="form-picker">{{form.district || '区/县'}}</view>
      </picker>
    </view>
    <view class="region-hint" wx:if="{{form.regionText}}">已选：{{form.regionText}}</view>
  </view>

  <view class="form-group">
    <view class="form-label">球队队徽</view>
    <view class="logo-block">
      <image wx:if="{{logoLocal}}" class="logo-preview" src="{{logoLocal}}" mode="aspectFill"></image>
      <view wx:else class="logo-placeholder" bindtap="onChooseLogo">
        <text>📷 上传队徽</text>
      </view>
      <view class="logo-actions">
        <view class="btn-logo" bindtap="onChooseLogo">{{logoLocal ? '重新选择' : '选择图片'}}</view>
        <view wx:if="{{logoLocal}}" class="btn-logo-clear" bindtap="onClearLogo">清除</view>
      </view>
    </view>
  </view>

  <view class="form-group">
    <view class="form-label">球队介绍</view>
    <textarea class="form-textarea" placeholder="球队简介 / 招募要求" value="{{form.description}}" bindinput="onInput" data-key="description" maxlength="200"></textarea>
  </view>

  <view class="form-group">
    <view class="form-label">是否招募</view>
    <view class="switch-row">
      <text>允许散客申请加入</text>
      <switch checked="{{form.recruitment}}" bindchange="onSwitchChange" color="#FF6B00" />
    </view>
  </view>

  <view class="bottom-action safe-bottom">
    <view class="btn-primary full" bindtap="onSubmit">创建球队</view>
  </view>
</view>
