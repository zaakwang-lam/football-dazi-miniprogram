<!-- pages/team/aa/aa.wxml -->
<view class="page">
  <view class="page-title">队费 AA</view>
  <view class="page-sub">微信支付收款，资金进入商户号。手续费按签约费率从到账金额扣除，队员实付不变。</view>

  <block wx:if="{{!loaded}}">
    <view class="empty">加载中...</view>
  </block>

  <block wx:elif="{{mode === 'list'}}">
    <view class="card" wx:if="{{!aaList.length}}">
      <view class="empty">还没有收款</view>
    </view>
    <view class="card" wx:if="{{aaList.length}}">
      <view class="card-title"><text class="card-title-text">收款记录</text></view>
      <view class="row" wx:for="{{aaList}}" wx:key="id" bindtap="onOpenHistory" data-id="{{item.id}}">
        <view class="member-info">
          <view class="member-name">{{item.title || '队费 AA'}}</view>
          <view class="member-role">总额 ¥{{item.totalAmount}} · {{item.itemCount}} 人</view>
        </view>
        <view class="badge {{item.status}}">{{item.statusText}}</view>
      </view>
    </view>
    <button wx:if="{{isCaptain}}" class="btn btn-primary" bindtap="onStart">发起收款</button>
    <view wx:else class="empty">等待队长发起后，在这里支付你的一份</view>
  </block>

  <block wx:elif="{{mode === 'create'}}">
    <view class="card">
      <view class="card-title"><text class="card-title-text">总金额（元）</text></view>
      <input class="total-input" type="digit" placeholder="例如 300" value="{{totalInput}}" bindinput="onTotalInput" />
      <view class="summary">
        <text>已选 <text class="em">{{selectedCount}}</text> 人</text>
        <text>人均约 <text class="em">¥{{perText}}</text></text>
      </view>
    </view>
    <view class="card">
      <view class="card-title"><text class="card-title-text">勾选付款队员</text></view>
      <view class="row" wx:for="{{members}}" wx:key="userId" bindtap="onToggleMember" data-id="{{item.userId}}">
        <view class="checkbox {{item.included ? 'checked' : ''}}">
          <text wx:if="{{item.included}}">✓</text>
        </view>
        <view class="avatar">{{item.initial}}</view>
        <view class="member-info">
          <view class="member-name">{{item.displayName}}</view>
          <view class="member-role">{{item.userId === userId ? '我' : '队员'}}</view>
        </view>
      </view>
    </view>
    <button class="btn btn-primary" bindtap="onSubmit">发起收款</button>
    <button class="btn btn-default" bindtap="onBackList">返回</button>
  </block>

  <block wx:elif="{{mode === 'detail' && current}}">
    <view class="card">
      <view class="card-title">
        <text class="card-title-text">{{current.title || '队费 AA'}}</text>
        <view class="badge {{current.status}}">{{current.status === 'collecting' ? '收款中' : current.status === 'done' ? '已完成' : '草稿'}}</view>
      </view>
      <view class="row">
        <view class="member-name">总金额</view>
        <view class="money">¥{{current.totalAmount}}</view>
      </view>
      <view class="row">
        <view class="member-name">人均</view>
        <view class="member-role">¥{{current.perAmount}}</view>
      </view>
    </view>
    <view class="card">
      <view class="card-title"><text class="card-title-text">付款明细</text></view>
      <view class="row" wx:for="{{current.items}}" wx:key="id">
        <view class="avatar">{{item.initial}}</view>
        <view class="member-info">
          <view class="member-name">{{item.displayName || '队员'}}{{item.mine ? '（我）' : ''}}</view>
        </view>
        <view class="pay-line">
          <text>¥{{item.amount}}</text>
          <text class="pay-status {{item.payStatus === 'paid' ? '' : 'unpaid'}}">{{item.payStatus === 'paid' ? '已付' : '待付'}}</text>
        </view>
      </view>
    </view>
    <button wx:if="{{myUnpaid}}" class="btn btn-primary" bindtap="onPay">{{paying ? '支付中...' : '微信支付我的一份'}}</button>
    <button class="btn btn-default" bindtap="onBackList">返回</button>
  </block>
</view>
