/* pages/team/checkin.wxss */
.page {
  padding: 0 0 40rpx;
}

.hero {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  padding: 60rpx 32rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 0 0 48rpx 48rpx;
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.location-card {
  background: #FFFFFF;
  margin: -40rpx 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.loc-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.loc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.loc-distance {
  font-size: 24rpx;
  color: #2ECC71;
  margin-bottom: 24rpx;
}

.checkin-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 16rpx 32rpx;
}

.member-list {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FACFE, #00F2FE);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.member-status {
  font-size: 24rpx;
}

.member-status.checked {
  color: #2ECC71;
}

.member-status.unchecked {
  color: #999999;
}

.attendList-count {
  color: #FF6B00;
}