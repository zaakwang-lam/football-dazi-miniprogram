<!-- pages/team/detail.wxml -->
<view class="page" wx:if="{{team}}">
  <view class="hero" style="background: {{team.bgColor}};">
    <view class="hero-avatar">{{team.shortName}}</view>
    <view class="hero-name">{{team.name}}</view>
    <view class="hero-meta">{{team.matchType || ''}} · {{team.city || ''}}{{team.district || ''}} · 成立 {{team.founded}}</view>
    <view class="hero-motto" wx:if="{{team.motto}}">"{{team.motto}}"</view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{team.members}}</text>
      <text class="stat-label">队员</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{team.attendance}}%</text>
      <text class="stat-label">出勤率</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{team.wins}}</text>
      <text class="stat-label">胜场</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{team.losses}}</text>
      <text class="stat-label">负场</text>
    </view>
  </view>

  <view class="section-title" wx:if="{{team.announcement}}">公告</view>
  <view class="announce-box" wx:if="{{team.announcement}}">
    <text>{{team.announcement}}</text>
  </view>

  <view class="section-title">队员 ({{team.members}})</view>
  <view class="member-grid">
    <view class="member-item" wx:for="{{members}}" wx:key="id">
      <view class="member-avatar">{{item.shortName}}</view>
      <text class="member-name">{{item.name}}</text>
      <text class="member-role">{{item.role}}</text>
    </view>
  </view>

  <!-- 队长操作 -->
  <view class="captain-actions" wx:if="{{isCaptain}}">
    <view class="cap-btn" bindtap="onEditTap">球队编辑</view>
    <view class="cap-btn danger" bindtap="onDissolveTap">解散球队</view>
  </view>

  <view class="bottom-bar">
    <button class="btn-share" open-type="share">分享球队</button>
    <view class="btn-primary" bindtap="onJoinTap" wx:if="{{!isMember && team.recruitment}}">申请加入</view>
    <view class="btn-leave" bindtap="onLeaveTap" wx:if="{{isMember && !isCaptain}}">退出球队</view>
  </view>
</view>
