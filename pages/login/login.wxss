/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5EB 0%, #F5F7FA 40%);
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 64rpx;
}

.hero-logo {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.login-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
}

.login-desc {
  margin: 16rpx 0 40rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.btn-wechat::after {
  border: none;
}

.btn-test {
  margin-top: 24rpx;
  background: #F5F7FA;
  color: #666;
  border-radius: 999rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #E8E8E8;
}

.btn-test::after {
  border: none;
}

.test-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #BBB;
  text-align: center;
}

.btn-icon {
  margin-right: 12rpx;
}

.agreement {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #CCC;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}

.checkbox.checked {
  background: #FF6B00;
  border-color: #FF6B00;
}

.link {
  color: #FF6B00;
}

.features {
  display: flex;
  justify-content: space-around;
  margin-top: 64rpx;
}

.feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
