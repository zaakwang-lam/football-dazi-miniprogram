/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5EB 0%, #F5F7FA 40%);
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
}
.hero { text-align: center; margin-bottom: 64rpx; }
.hero-logo { font-size: 96rpx; margin-bottom: 16rpx; }
.hero-name { font-size: 44rpx; font-weight: 700; color: #1A1A1A; }
.hero-sub { margin-top: 12rpx; font-size: 26rpx; color: #999; }
.login-card {
  background: #fff; border-radius: 32rpx; padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex; flex-direction: column; align-items: center;
}
.login-title {
  font-size: 34rpx; font-weight: 700; color: #1A1A1A; text-align: center; width: 100%;
}
.login-desc {
  margin: 16rpx 0 40rpx; font-size: 26rpx; color: #999; text-align: center; width: 100%;
}
.btn-wechat {
  width: 100% !important; max-width: 100%;
  background: linear-gradient(135deg, #07C160, #06AD56) !important;
  color: #fff !important; border-radius: 999rpx !important;
  font-size: 30rpx; font-weight: 600; height: 88rpx; line-height: 88rpx;
  border: none !important; display: flex !important; align-items: center; justify-content: center;
  margin: 0 auto;
}
.btn-wechat::after { border: none; }
.btn-test {
  margin-top: 24rpx; width: 100%;
  background: #F5F7FA; color: #666; border-radius: 999rpx;
  font-size: 28rpx; height: 80rpx; line-height: 80rpx; border: 1rpx solid #E8E8E8;
}
.btn-test::after { border: none; }
.test-hint { margin-top: 12rpx; font-size: 22rpx; color: #BBB; text-align: center; }
.btn-icon { margin-right: 12rpx; }
.agreement {
  display: flex; align-items: flex-start; margin-top: 32rpx;
  font-size: 24rpx; color: #666; line-height: 1.5; width: 100%;
}
.checkbox {
  width: 32rpx; height: 32rpx; border: 2rpx solid #CCC; border-radius: 8rpx;
  margin-right: 12rpx; flex-shrink: 0; margin-top: 2rpx;
  display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #fff;
}
.checkbox.checked { background: #FF6B00; border-color: #FF6B00; }
.link { color: #FF6B00; }
.features { display: flex; justify-content: space-around; margin-top: 64rpx; }
.feature { display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #666; }
.feature-icon { font-size: 40rpx; margin-bottom: 8rpx; }

.profile-card { align-items: stretch; }
.btn-privacy {
  width: 100%;
  margin: 0 0 24rpx;
  padding: 20rpx;
  background: #FFF3E8;
  color: #FF6B00;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: 2rpx solid #FFD0A8;
  line-height: 1.4;
}
.btn-privacy::after { border: none; }

.profile-avatar-block {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 20rpx;
  margin: 8rpx 0 32rpx;
  width: 100%;
}
.avatar-choose-btn {
  flex: 1;
  margin: 0;
  padding: 20rpx;
  background: #FFF8F2;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0C8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  min-height: 160rpx;
}
.avatar-choose-btn::after { border: none; }
.avatar-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #FFE8D6;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-preview.placeholder {
  font-size: 42rpx;
  color: #CCC;
}
.avatar-choose-text {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 600;
}
.avatar-album-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  min-height: 160rpx;
  border-radius: 20rpx;
  background: #F5F6F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  border: 2rpx solid #EEEEEE;
  line-height: 1.2;
}
.avatar-album-btn::after { border: none; }
.profile-nick-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  width: 100%;
}
.profile-nick-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #F5F6F8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}
.profile-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #BBB;
  text-align: center;
  width: 100%;
  line-height: 1.5;
}
.relogin-link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #FF6B00;
  text-align: center;
  width: 100%;
  padding: 12rpx;
}
