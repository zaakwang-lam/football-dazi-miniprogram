/* pages/login/login.wxss */
.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #F5F7FA;
}

.hero {
  text-align: center;
  padding: 80rpx 32rpx 60rpx;
}

.hero-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B00;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #999999;
}

.login-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 微信登录按钮（绿色） */
.btn-wechat.full {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  background: #07C160;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  border: none;
}

.btn-wechat::after {
  border: none;
}

/* 手机号登录按钮（橙色品牌色） */
.btn-phone.full {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  background: #FF6B00;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  border: none;
}

.btn-phone::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 兼容旧样式 */
.btn-primary.full {
  display: block;
  width: 100%;
}

.agreement {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #666666;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #CCCCCC;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
}

.checkbox.checked {
  background: #FF6B00;
  border-color: #FF6B00;
}

.link {
  color: #FF6B00;
}

.features {
  display: flex;
  justify-content: space-around;
  padding: 60rpx 32rpx;
}

.feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666666;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #FFE8D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}