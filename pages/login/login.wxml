<!-- pages/login/login.wxml -->
<view class="page">
  <view class="hero">
    <view class="hero-logo">⚽</view>
    <view class="hero-name">足球搭子</view>
    <view class="hero-sub">广州业余足球一站式平台</view>
  </view>

  <view class="login-card">
    <view class="login-title">登录后享受完整功能</view>
    <view class="login-desc">订场、组队、约战，一站式搞定</view>

    <!-- 微信一键登录 -->
    <button class="btn-wechat full" bindtap="onWechatLoginTap">
      <text class="btn-icon">💬</text>
      <text>微信一键登录</text>
    </button>

    <!-- 手机号一键登录（微信官方能力，需 button open-type） -->
    <button class="btn-phone full" open-type="getPhoneNumber" bindgetphonenumber="onPhoneLoginTap">
      <text class="btn-icon">📱</text>
      <text>手机号一键登录</text>
    </button>

    <view class="agreement" bindtap="onAgreeTap">
      <view class="checkbox {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>我已阅读并同意 <text class="link">《用户协议》</text> 和 <text class="link">《隐私政策》</text></text>
    </view>
  </view>

  <view class="features">
    <view class="feature">
      <view class="feature-icon">📍</view>
      <text>附近场地</text>
    </view>
    <view class="feature">
      <view class="feature-icon">👥</view>
      <text>凑人约战</text>
    </view>
    <view class="feature">
      <view class="feature-icon">💰</view>
      <text>队费AA</text>
    </view>
    <view class="feature">
      <view class="feature-icon">📊</view>
      <text>数据统计</text>
    </view>
  </view>
</view>