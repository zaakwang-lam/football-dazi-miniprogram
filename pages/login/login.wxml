<!-- pages/login/login.wxml -->
<!-- 头像能力按 8.18～8.19 可用写法：button open-type="chooseAvatar" + bind:chooseavatar，不加 plain -->
<view class="page">
  <view class="hero">
    <view class="hero-logo">⚽</view>
    <view class="hero-name">足球搭子</view>
    <view class="hero-sub">广州业余足球一站式平台</view>
  </view>

  <!-- ========== 步骤1：微信登录 ========== -->
  <view class="login-card" wx:if="{{step === 'login'}}">
    <view class="login-title">微信一键登录</view>
    <view class="login-desc">登录后享受完整功能：订场、组队、约战</view>

    <button class="btn-wechat full" bindtap="onLoginTap" disabled="{{loading}}">
      <text wx:if="{{loading}}">登录中...</text>
      <block wx:else>
        <text class="btn-icon">💬</text>
        <text>微信一键登录</text>
      </block>
    </button>

    <block wx:if="{{showTestLogin}}">
      <button class="btn-test full" bindtap="onTestLoginTap" disabled="{{loading}}">
        审核测试账号登录
      </button>
      <view class="test-hint">测试账号可切换「个人方 / 球场方」，密钥见提审说明</view>
    </block>

    <view class="agreement" bindtap="onAgreeTap">
      <view class="checkbox {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>我已阅读并同意 <text class="link" catchtap="onAgreementTap">《用户协议》</text> 和 <text class="link" catchtap="onPrivacyTap">《隐私政策》</text></text>
    </view>
  </view>

  <!-- ========== 步骤2：头像 + 昵称 ========== -->
  <view class="login-card profile-card" wx:if="{{step === 'profile'}}">
    <view class="login-title">完善资料</view>
    <view class="login-desc">请选择微信头像并填写昵称，便于队友识别</view>

    <!-- 隐私未授权时先点同意，否则 chooseAvatar 真机常无响应 -->
    <button
      wx:if="{{needPrivacy}}"
      class="btn-privacy"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgreePrivacy"
    >请先同意隐私保护指引（点此授权）</button>

    <view class="profile-avatar-row">
      <button
        class="avatar-choose-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseWechatAvatar"
        bindtap="onAvatarBtnTap"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-preview" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-preview placeholder">👤</view>
        <text class="avatar-choose-text">选微信头像</text>
      </button>
      <button class="avatar-album-btn" bindtap="onChooseLocalAvatar">从相册选择</button>
    </view>

    <view class="profile-nick-label">微信昵称</view>
    <input
      class="profile-nick-input"
      type="nickname"
      maxlength="20"
      placeholder="点击输入，可选微信昵称"
      value="{{draftNickname}}"
      bindinput="onNicknameInput"
      bindblur="onNicknameBlur"
    />

    <button
      class="btn-wechat full"
      style="margin-top: 40rpx;"
      bindtap="onConfirmProfile"
      disabled="{{loading || uploadingAvatar}}"
    >
      <text wx:if="{{loading}}">保存中...</text>
      <text wx:elif="{{uploadingAvatar}}">头像上传中...</text>
      <text wx:else>确认并继续</text>
    </button>
    <view class="profile-tip">选头像后应弹出微信头像面板；昵称输入框在真机可选用微信昵称</view>
    <view class="relogin-link" bindtap="onBackToLogin">重新登录 / 退出当前账号</view>
  </view>

  <view class="features" wx:if="{{step === 'login'}}">
    <view class="feature">
      <view class="feature-icon">📍</view>
      <text>附近场地</text>
    </view>
    <view class="feature">
      <view class="feature-icon">👥</view>
      <text>凑人约战</text>
    </view>
    <view class="feature">
      <view class="feature-icon">💰</view>
      <text>队费AA</text>
    </view>
    <view class="feature">
      <view class="feature-icon">📊</view>
      <text>数据统计</text>
    </view>
  </view>
</view>
