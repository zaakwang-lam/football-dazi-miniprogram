/* pages/court-orders/list.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.tab.active {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  font-weight: 600;
}

.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.head-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
  font-family: monospace;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.status-pending { background: #FFF3E0; color: #FF6B00; }
.status-success { background: #E8F5E9; color: #2E7D32; }
.status-canceled { background: #F5F5F5; color: #999999; }
.status-unknown { background: #F5F5F5; color: #999999; }

.order-body {
  border-top: 2rpx solid #F5F7FA;
  padding: 16rpx 0;
}

.info-row {
  display: flex;
  font-size: 28rpx;
  padding: 8rpx 0;
}

.info-label {
  width: 140rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  color: #1A1A1A;
}

.info-val.highlight {
  color: #FF6B00;
  font-weight: 600;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-call {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: #FFFFFF;
}

.btn-secondary {
  background: #FFE8D6;
  color: #FF6B00;
}

.btn-danger {
  background: #FFEBEE;
  color: #C62828;
}

.btn-outline {
  flex: 0 0 100rpx;
  border: 2rpx solid #C62828;
  background: transparent;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
