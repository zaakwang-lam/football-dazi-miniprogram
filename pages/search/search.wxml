<view class="page">
  <view class="search-bar">
    <input class="search-input" focus placeholder="搜索球场或球队名称" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="onConfirm" />
    <text class="search-btn" bindtap="onSearch">搜索</text>
    <text class="clear-btn" wx:if="{{keyword}}" bindtap="onClear">清除</text>
  </view>

  <view class="tabs" wx:if="{{loaded}}">
    <view class="tab {{tab === 'all' ? 'on' : ''}}" bindtap="onTab" data-tab="all">全部</view>
    <view class="tab {{tab === 'court' ? 'on' : ''}}" bindtap="onTab" data-tab="court">球场</view>
    <view class="tab {{tab === 'team' ? 'on' : ''}}" bindtap="onTab" data-tab="team">球队</view>
  </view>

  <view class="section" wx:if="{{loaded && (tab === 'all' || tab === 'court')}}">
    <view class="sec-title">球场 ({{courts.length}})</view>
    <view class="item" wx:for="{{courts}}" wx:key="id" bindtap="onCourtTap" data-id="{{item.id}}">
      <text class="name">{{item.name}}</text>
      <text class="meta">{{item.typeLabel}} · {{item.address || item.district || ''}}</text>
    </view>
    <view class="empty" wx:if="{{!courts.length}}">未找到相关球场</view>
  </view>

  <view class="section" wx:if="{{loaded && (tab === 'all' || tab === 'team')}}">
    <view class="sec-title">球队 ({{teams.length}})</view>
    <view class="item" wx:for="{{teams}}" wx:key="id" bindtap="onTeamTap" data-id="{{item.id}}">
      <text class="name">{{item.name}}</text>
      <text class="meta">{{item.matchType || ''}} · {{item.district || ''}} · {{item.memberCount || 0}}人</text>
    </view>
    <view class="empty" wx:if="{{!teams.length}}">未找到相关球队</view>
  </view>

  <view class="hint" wx:if="{{!loaded}}">输入球场或球队名称后点击搜索</view>
</view>
