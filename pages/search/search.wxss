.page { min-height: 100vh; background: #F5F5F5; padding: 24rpx; }
.search-bar {
  display: flex; align-items: center; gap: 16rpx; background: #fff;
  border-radius: 999rpx; padding: 16rpx 24rpx; margin-bottom: 24rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.search-btn { color: #FF6B00; font-weight: 600; font-size: 28rpx; }
.clear-btn { color: #999; font-size: 26rpx; }
.tabs { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.tab {
  padding: 12rpx 28rpx; background: #fff; border-radius: 999rpx; font-size: 26rpx; color: #666;
}
.tab.on { background: #FFE8D6; color: #FF6B00; font-weight: 600; }
.section {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
}
.sec-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.item {
  padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.item:last-child { border-bottom: none; }
.name { display: block; font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.meta { font-size: 24rpx; color: #999; margin-top: 6rpx; display: block; }
.empty { text-align: center; color: #bbb; padding: 24rpx; font-size: 26rpx; }
.hint { text-align: center; color: #bbb; margin-top: 80rpx; font-size: 28rpx; }
