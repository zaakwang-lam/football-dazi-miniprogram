<view class="page">
  <view class="plugin-error" wx:if="{{pluginError}}">{{pluginError}}</view>

  <view class="model-row" wx:else>
    <view
      class="model-chip {{modelId === item.id ? 'on' : ''}}"
      wx:for="{{models}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onModelTap"
    >{{item.label}}</view>
  </view>

  <scroll-view class="thread" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="empty" wx:if="{{!messages.length && !pluginError}}">
      <view class="empty-title">问爱拍球</view>
      <view class="empty-desc">订场、退订、找球场、改空闲时段，直接问。下单和退款仍要在页面里操作。</view>
      <view class="suggests">
        <view class="suggest" wx:for="{{suggests}}" wx:key="*this" data-text="{{item}}" bindtap="onSuggest">{{item}}</view>
      </view>
    </view>

    <view class="msg {{item.role}}" wx:for="{{messages}}" wx:key="index">
      <view class="bubble">{{item.content || (sending && item.role === 'assistant' ? '正在想…' : '')}}</view>
    </view>
    <view id="ai-bottom" class="bottom-anchor"></view>
  </scroll-view>

  <view class="composer">
    <input class="input" value="{{input}}" placeholder="问问怎么订场、退订" confirm-type="send" bindinput="onInput" bindconfirm="onSend" disabled="{{!ready || sending}}" />
    <view class="send" wx:if="{{!sending}}" bindtap="onSend">发送</view>
    <view class="send stop" wx:else bindtap="onStop">停止</view>
  </view>
</view>
