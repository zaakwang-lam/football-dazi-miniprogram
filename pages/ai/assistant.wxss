.page { height: 100vh; display: flex; flex-direction: column; background: #f5f6f8; }
.plugin-error { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; color: #666; font-size: 28rpx; line-height: 1.6; }
.model-row { display: flex; gap: 16rpx; padding: 20rpx 24rpx 0; }
.model-chip { padding: 10rpx 22rpx; border-radius: 999rpx; background: #fff; color: #666; font-size: 24rpx; }
.model-chip.on { background: #071433; color: #fff; }
.thread { flex: 1; height: 0; padding: 24rpx; box-sizing: border-box; }
.empty-title { font-size: 40rpx; font-weight: 700; color: #071433; }
.empty-desc { margin-top: 12rpx; color: #888; font-size: 26rpx; line-height: 1.5; }
.suggests { margin-top: 28rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.suggest { background: #fff; color: #1B4FD8; border-radius: 999rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.msg { display: flex; margin-bottom: 20rpx; }
.msg.user { justify-content: flex-end; }
.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; }
.msg.user .bubble { background: #1B4FD8; color: #fff; }
.msg.assistant .bubble { background: #fff; color: #222; }
.bottom-anchor { height: 1px; }
.composer { display: flex; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; }
.input { flex: 1; background: #f5f6f8; border-radius: 999rpx; padding: 18rpx 28rpx; font-size: 28rpx; }
.send { width: 120rpx; text-align: center; line-height: 72rpx; border-radius: 999rpx; background: #1B4FD8; color: #fff; font-size: 28rpx; }
.send.stop { background: #999; }
