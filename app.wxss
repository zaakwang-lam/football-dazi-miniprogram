/* 全局样式 - 夜赛深蓝 + 星点 */

page {
  background-color: #F3F5FA;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

/* ===== 设计系统 =====
   欧冠夜赛气质：午夜海军蓝 + 电光蓝，星点为自有几何装饰（非官方星球）
*/
:root {
  --primary: #1B4FD8;
  --primary-dark: #071433;
  --primary-mid: #0D2A6B;
  --primary-light: #E8EEFF;
  --accent: #4C8DFF;
  --star: #F0C75E;
  --secondary: #4C8DFF;
  --success: #2ECC71;
  --warning: #F0C75E;
  --danger: #FF4757;

  --text-1: #1A1A1A;
  --text-2: #666666;
  --text-3: #999999;
  --text-4: #CCCCCC;

  --bg-1: #FFFFFF;
  --bg-2: #F3F5FA;
  --bg-3: #E8EEF5;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;
}

.card {
  background: var(--bg-1);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(7, 20, 51, 0.06);
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #0D2A6B 0%, #1B4FD8 52%, #4C8DFF 100%);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(27, 79, 216, 0.38);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--bg-1);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-full);
  padding: 22rpx 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  display: inline-block;
}

.btn-secondary::after {
  border: none;
}

/* 夜赛顶栏 */
.night-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(165deg, #050D24 0%, #0D2A6B 50%, #1B4FD8 100%);
}

.star-field {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.star {
  position: absolute;
  color: #F0C75E;
  line-height: 1;
  opacity: 0.92;
}

.star.silver { color: #D7E2FF; opacity: 0.75; }
.star.s1 { left: 24rpx; top: 18rpx; font-size: 22rpx; }
.star.s2 { left: 18%; top: 58rpx; font-size: 16rpx; opacity: 0.7; }
.star.s3 { right: 28%; top: 16rpx; font-size: 20rpx; }
.star.s4 { right: 40rpx; top: 44rpx; font-size: 28rpx; }
.star.s5 { left: 46%; top: 8rpx; font-size: 14rpx; }
.star.s6 { right: 16%; bottom: 20rpx; font-size: 18rpx; }
.star.s7 { left: 32%; bottom: 12rpx; font-size: 12rpx; color: #D7E2FF; }
.star.s8 { left: 72%; top: 70rpx; font-size: 14rpx; }

.night-streak {
  position: absolute;
  right: -80rpx;
  top: -40rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(76,141,255,0.35) 0%, rgba(76,141,255,0) 70%);
  pointer-events: none;
}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: #E8F8EE;
  color: var(--success);
}

.tag-warning {
  background: #FFF7E6;
  color: var(--warning);
}

.tag-danger {
  background: #FFEAEC;
  color: var(--danger);
}

.tag-info {
  background: #E6F2FF;
  color: var(--secondary);
}

.flex { display: flex; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-1 { flex: 1; }

.text-primary { color: var(--primary); }
.text-secondary { color: var(--secondary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-2 { color: var(--text-2); }
.text-3 { color: var(--text-3); }
.text-bold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 44rpx; }

.mt-12 { margin-top: 24rpx; }
.mt-20 { margin-top: 40rpx; }
.mt-30 { margin-top: 60rpx; }
.mb-12 { margin-bottom: 24rpx; }
.mb-20 { margin-bottom: 40rpx; }

.divider {
  height: 2rpx;
  background: var(--bg-3);
  margin: 24rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: var(--text-3);
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}
