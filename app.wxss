/* 全局样式 - 运动风 + 圆角设计 */

page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* ===== 设计系统变量 ===== */
:root {
  --primary: #FF6B00;       /* 活力橙 */
  --primary-light: #FFE8D6;
  --secondary: #007AFF;     /* 科技蓝 */
  --success: #2ECC71;       /* 草地绿 */
  --warning: #FFB800;
  --danger: #FF4757;

  --text-1: #1A1A1A;
  --text-2: #666666;
  --text-3: #999999;
  --text-4: #CCCCCC;

  --bg-1: #FFFFFF;
  --bg-2: #F5F7FA;
  --bg-3: #EBEEF3;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;
}

/* ===== 通用组件类 ===== */

/* 卡片 */
.card {
  background: var(--bg-1);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C42 100%);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  display: inline-block;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 0, 0.3);
}

.btn-primary::after {
  border: none;
}

/* 次按钮 */
.btn-secondary {
  background: var(--bg-1);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-full);
  padding: 22rpx 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  display: inline-block;
}

.btn-secondary::after {
  border: none;
}

/* 胶囊标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: #E8F8EE;
  color: var(--success);
}

.tag-warning {
  background: #FFF7E6;
  color: var(--warning);
}

.tag-danger {
  background: #FFEAEC;
  color: var(--danger);
}

.tag-info {
  background: #E6F2FF;
  color: var(--secondary);
}

/* Flex 工具 */
.flex {
  display: flex;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 文字 */
.text-primary { color: var(--primary); }
.text-secondary { color: var(--secondary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-2 { color: var(--text-2); }
.text-3 { color: var(--text-3); }
.text-bold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 44rpx; }

/* 间距 */
.mt-12 { margin-top: 24rpx; }
.mt-20 { margin-top: 40rpx; }
.mt-30 { margin-top: 60rpx; }
.mb-12 { margin-bottom: 24rpx; }
.mb-20 { margin-bottom: 40rpx; }

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--bg-3);
  margin: 24rpx 0;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: var(--text-3);
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

/* 安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}